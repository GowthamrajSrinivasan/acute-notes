{
  "apphosting": {
    "backendId": "acute-notes",
    "rootDir": "/",
    "alwaysDeployFromSource": true,
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log",
      ".next",
      ".next-prod",
      ".env.local",
      ".env.*.local",
      ".ai",
      ".claude",
      ".playwright-mcp",
      "test-results",
      "playwright-report",
      "coverage",
      "dist-desktop",
      "out",
      "hosting-redirect"
    ]
  },
  "hosting": {
    "site": "acute",
    "public": "hosting-redirect",
    "redirects": [
      {
        "regex": "^/(.*)$",
        "destination": "https://acute-notes--acute-notes.us-central1.hosted.app/:1",
        "type": 302
      }
    ]
  }
}
