    "doc_KA2CisGaWvaq3h6u0qq3": {
      "id": "doc_KA2CisGaWvaq3h6u0qq3",
      "workspaceId": "default",
      "canvasId": "cv_n9U5El3G08x7Y1dqFHhk",
      "kind": "block",
      "title": "Untitled",
      "snapshot": [
        {
          "type": "heading",
          "props": {
            "level": 3
          },
          "content": "Notes"
        },
        {
          "type": "paragraph",
          "id": "9f14881e-7027-47a5-bf55-68411696dbee",
          "props": {
            "backgroundColor": "default",
            "textColor": "default",
            "textAlignment": "left"
          },
          "content": [
            {
              "type": "text",
              "text": "¹ A unique identifier for an operation.\n ² Prevents duplicate operations.\n ³ Example of an idempotency key in a payment request.\n ⁴ Client retries with the same key after a connection drop.\n ⁵ Server uses the key to return the original result, preventing double charging.\n ⁶ Protection is limited by the server's memory of the key.\n ⁷ Stored results expire after 24 hours, making retries after this period new requests.\n ⁸ Reusing a key with different request parameters (e.g., amount) requires rejection, not returning the old result.\n ⁹ Idempotency keys ensure safe retries only within a specific timeframe and do not prevent all duplicate operations.",
              "styles": {}
            }
          ],
          "children": []
        }
      ],
      "createdAt": 1792435918849,
      "updatedAt": 1792435918849,
