    },
    "doc_3CJ2p93H7UwJreQf5ZTF": {
      "id": "doc_3CJ2p93H7UwJreQf5ZTF",
      "workspaceId": "default",
      "canvasId": "cv_OY0vQ2pOBXGFh1fGJ6J3",
      "kind": "block",
      "title": "Untitled",
      "snapshot": [
        {
          "type": "paragraph",
          "content": "Idempotency keys ensure safe retries within a 24-hour window, preventing duplicate operations.",
          "props": {
            "backgroundColor": "orange"
          }
        }
      ],
      "createdAt": 1792436665434,
      "updatedAt": 1792436665434,
      "metadata": {
        "ai": {
          "createdBy": "ai",
          "operationId": "op_wx8D1wuLQlQdy2y7kslQ",
          "task": "generate_visual_plan",
          "provider": "openrouter",
          "model": "google/gemini-2.5-flash",
          "authType": "api_key"
        }
      }
    },
    "doc_umFv946DNyADAFfiDvR1": {
      "id": "doc_umFv946DNyADAFfiDvR1",
      "workspaceId": "default",
      "canvasId": "cv_OY0vQ2pOBXGFh1fGJ6J3",
      "kind": "block",
      "title": "Untitled",
      "snapshot": [
        {
          "type": "paragraph",
          "id": "72dddb7a-20de-4b9e-aa03-f9b1e98fa3f0",
          "props": {
            "backgroundColor": "default",
            "textColor": "default",
            "textAlignment": "left"
          },
          "content": [
            {
              "type": "text",
              "text": "An idempotency key is a unique value that a client attaches to a request so that the server can recognise a retry of the same operation¹. If the server has already completed a request with that key, it returns the stored result instead of performing the operation again.",
              "styles": {}
            }
          ],
          "children": []
        },
        {
          "type": "paragraph",
          "id": "8e53fae1-4460-4693-95cc-a3e4cc57d79f",
          "props": {
            "backgroundColor": "default",
            "textColor": "default",
            "textAlignment": "left"
          },
          "content": [
            {
              "type": "text",
              "text": "For example, a checkout client sends ",
              "styles": {}
            },
            {
              "type": "text",
              "text": "Idempotency-Key: 7f3c-91ab",
              "styles": {
                "code": true
              }
            },
            {
              "type": "text",
              "text": " with a payment request. The connection drops before the response arrives, so the client retries with the same key. The server finds the stored result for ",
              "styles": {}
            },
            {
              "type": "text",
              "text": "7f3c-91ab",
              "styles": {
                "code": true
              }
            },
            {
              "type": "text",
              "text": " and returns the original confirmation, and the customer is charged once.",
              "styles": {}
            }
          ],
          "children": []
        },
        {
          "type": "paragraph",
          "id": "42257d6a-03be-4f14-bf95-0dc604795c3c",
          "props": {
            "backgroundColor": "default",
            "textColor": "default",
            "textAlignment": "left"
          },
          "content": [
            {
              "type": "text",
              "text": "Keys only protect against duplicates while the server still remembers them². In this design, stored results expire after 24 hours, so a retry sent after that window is treated as a new payment. Keys also do not make two different requests safe³: if a client reuses a key with a different amount, the server must reject the request rather than return the old result.",
              "styles": {}
            }
          ],
          "children": []
        },
        {
          "type": "paragraph",
          "id": "aafcbe17-603f-453b-8f99-03e824fc6718",
          "props": {
            "backgroundColor": "default",
            "textColor": "default",
            "textAlignment": "left"
          },
          "content": [
            {
              "type": "text",
              "text": "In short, idempotency keys make retries safe within a bounded window; they are not a general guarantee against duplicate operations.",
              "styles": {}
            }
          ],
          "children": []
        }
      ],
      "createdAt": 1792436665434,
      "updatedAt": 1792436665434,
      "metadata": {
        "ai": {
          "createdBy": "ai",
          "operationId": "op_wx8D1wuLQlQdy2y7kslQ",
          "task": "generate_visual_plan",
          "provider": "openrouter",
          "model": "google/gemini-2.5-flash",
          "authType": "api_key",
          "contentSourceId": "src_wcGw22NxYTrP8TFnxS8x",
          "contentSourceVersion": 1,
          "stableNodeKey": "Idempotency keys § text#0",
          "contentFingerprint": "cpms0srl2gt"
        }
      }
    },
    "doc_ZH0WLK6hwk0lIadWvgL7": {
      "id": "doc_ZH0WLK6hwk0lIadWvgL7",
      "workspaceId": "default",
      "canvasId": "cv_OY0vQ2pOBXGFh1fGJ6J3",
      "kind": "block",
      "title": "Untitled",
      "snapshot": [
        {
          "type": "paragraph",
          "id": "387f25d3-5b6d-46d0-8975-ece5179c5977",
          "props": {
            "backgroundColor": "default",
            "textColor": "default",
            "textAlignment": "left"
          },
          "content": [
            {
              "type": "text",
              "text": "¹ Prevents duplicate operations from being processed multiple times.\n ² The server's memory of keys is finite.\n ³ Reusing a key with different request parameters will result in rejection.",
              "styles": {}
            }
          ],
          "children": []
        }
      ],
      "createdAt": 1792436665434,
      "updatedAt": 1792436665434,
      "metadata": {
