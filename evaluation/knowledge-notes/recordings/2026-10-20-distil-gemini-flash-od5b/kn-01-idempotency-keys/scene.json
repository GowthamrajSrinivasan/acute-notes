    "doc_560OBtgbpAimeEZwbGx3": {
      "id": "doc_560OBtgbpAimeEZwbGx3",
      "workspaceId": "default",
      "canvasId": "cv_mJ9uoQ5fu3HNLDmzYUCw",
      "kind": "block",
