      "snapshot": [
        {
          "type": "paragraph",
          "id": "7c0a432d-9a8e-4bb8-8ce7-6d1ac29ff42b",
          "props": {
            "backgroundColor": "default",
            "textColor": "default",
            "textAlignment": "left"
          },
          "content": [
            {
              "type": "text",
              "text": "¹ A unique identifier for a request.\n ² Prevents re-execution of the same operation.\n ³ Example of an idempotency key in a payment request.\n ⁴ Client retries with the same key after a connection drop.\n ⁵ Server uses the key to return the original result, preventing duplicate charges.\n ⁶ Protection is limited to the server's memory of the key.\n ⁷ Stored results have a 24-hour expiration; retries after this period are new operations.\n ⁸ Reusing a key with different request parameters (e.g., amount) requires rejection, not returning the old result.\n ⁹ Idempotency keys ensure safe retries within a time limit, but not a universal guarantee against all duplicate operations.",
              "styles": {}
            }
          ],
          "children": []
        }
      ],
