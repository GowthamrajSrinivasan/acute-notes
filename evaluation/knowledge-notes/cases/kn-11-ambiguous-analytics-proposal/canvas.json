{
  "datasetVersion": "1.0.0",
  "caseId": "kn-11-ambiguous-analytics-proposal",
  "template": "sectioned",
  "templateNote": "Sectioned, so the stated design can be an interactive architecture frame (group diagram 'architecture' with kinded shapes) beside ordinary frames for the stated rules and for the open questions and conflicts. The architecture template has no frames and drops publishes/writes.",
  "frames": [
    {
      "id": "f.design",
      "title": "Stated design: event flow",
      "titleMatch": { "all": [["stated design", "event flow", "as proposed", "proposed design", "architecture"]] },
      "purpose": "The pipeline exactly as the proposal states it: SDKs → collector → topic → enrichment → warehouse, with the registry and the user service.",
      "rationale": "The components and their stated links are one diagram. Disputed details are marked on the elements they concern (warehouse cadence and retention, the user-service link), never resolved.",
      "children": ["e.sdk", "e.collector", "e.registry", "e.bus", "e.enrichment", "e.user-service", "e.warehouse"],
      "arrangement": "chain",
      "diagram": "architecture",
      "separateFrom": [{ "frame": "f.open", "reason": "Facts the proposal states must stay apart from its contradictions and gaps, so a reader can tell which is which." }],
      "requirement": "mandatory",
      "support": "implemented"
    },
    {
      "id": "f.requirements",
      "title": "Stated goal, rules and rollout",
      "titleMatch": { "all": [["rule", "requirement", "rollout", "goal"]] },
      "purpose": "What the proposal commits to in words: the goal, privacy rules, scope and the phase-1 plan.",
      "rationale": "Stated commitments that aren't components; grouping them keeps the diagram clean and keeps them apart from the open questions.",
      "children": ["e.goal", "e.privacy", "e.non-goals", "e.rollout"],
      "arrangement": "grid",
      "requirement": "mandatory",
      "support": "implemented"
    },
    {
      "id": "f.open",
      "title": "Open questions and conflicts",
      "titleMatch": { "all": [["open question", "conflict", "unresolved", "contradiction", "gaps"]] },
      "purpose": "Everything the proposal contradicts or leaves out, each item marked as needing review.",
      "rationale": "Keeping contradictions and gaps in their own frame stops them from being read as part of the stated design and makes the review list visible.",
      "children": ["e.conflict-freshness", "e.conflict-retention", "e.open-registry-owner", "e.open-user-service", "e.open-other"],
      "arrangement": "grid",
      "separateFrom": [{ "frame": "f.design", "reason": "Assumptions and conflicts are not facts of the design." }],
      "requirement": "mandatory",
      "support": "implemented"
    }
  ],
