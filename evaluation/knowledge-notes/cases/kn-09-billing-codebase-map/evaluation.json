    { "id": "a.open-questions", "dimension": "coverage", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The open questions (monthly trigger, topic owner) are kept and marked unknown.", "check": { "check": "text_present", "element": "e.open-questions", "all": [["unknown", "not found", "could not find", "no scheduler", "not listed", "none is listed"]], "why": "open questions must read as unknown, not as answered (u52, u54)" } },
