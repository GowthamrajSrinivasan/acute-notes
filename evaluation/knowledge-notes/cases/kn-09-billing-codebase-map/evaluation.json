    { "id": "a.rel-generate-publish", "dimension": "relationships", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "generateInvoice calls the publisher (labelled).", "check": { "check": "relationship_present", "relationship": "r.generate-publish" } },
    { "id": "a.rel-collect-reads", "dimension": "relationships", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "regression": "dependency_reversed", "description": "collectUsage reads usage_events, in that direction.", "check": { "check": "relationship_present", "relationship": "r.collect-reads-usage" } },
    { "id": "a.no-reversed-read", "dimension": "relationships", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "regression": "dependency_reversed", "description": "No arrow runs from usage_events to collectUsage.", "check": { "check": "relationship_absent", "from": "e.usage-events", "to": "e.collect", "why": "the function reads the table; the table does nothing to the function (u21)" } },
    { "id": "a.no-collect-writes", "dimension": "relationships", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "collectUsage is not drawn as writing usage_events.", "check": { "check": "relationship_absent", "from": "e.collect", "to": "e.usage-events", "types": ["writes"], "why": "u23: it does not write to any table" } },
    { "id": "a.rel-price-reads", "dimension": "relationships", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "priceUsage reads price_plans (labelled).", "check": { "check": "relationship_present", "relationship": "r.price-reads-plans" } },
    { "id": "a.rel-discount-hedged", "dimension": "relationships", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "regression": "mislabeled_architecture_edge", "description": "Where the inferred discounts edge is drawn, its label says it is unconfirmed. (The evaluator can't express 'if drawn': an output that leaves the edge out and keeps the hedge on the pricing card fails this major check but passes a.discount-hedged.)", "check": { "check": "relationship_present", "relationship": "r.price-reads-discounts" } },
    { "id": "a.rel-tax-taxwell", "dimension": "relationships", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The tax client calls Taxwell (labelled).", "check": { "check": "relationship_present", "relationship": "r.tax-calls-taxwell" } },
    { "id": "a.rel-publish-topic", "dimension": "relationships", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The publisher publishes to billing-events (labelled).", "check": { "check": "relationship_present", "relationship": "r.publish-topic" } },
    { "id": "a.edges-labeled", "dimension": "relationships", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "regression": "unlabeled_architecture_edge", "description": "Every calls/reads/writes/publishes/subscribes arrow says what it does.", "check": { "check": "architecture_edges_labeled", "types": ["calls", "reads", "writes", "publishes", "subscribes"] } },

    { "id": "a.frame-flow", "dimension": "grouping", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The verified invoice path is one frame.", "check": { "check": "frame_present", "frame": "f.invoice-flow" } },
    { "id": "a.frame-structure", "dimension": "grouping", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "Modules and data contract have a frame.", "check": { "check": "frame_present", "frame": "f.structure" } },
    { "id": "a.frame-reading", "dimension": "grouping", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "Interpretation and open questions have their own frame.", "check": { "check": "frame_present", "frame": "f.reading" } },
    { "id": "a.frame-count", "dimension": "grouping", "severity": "minor", "method": "deterministic", "target": "plan", "support": "implemented", "description": "A handful of meaningful frames, not one per source heading.", "check": { "check": "frame_count", "min": 2, "max": 5 } },
    { "id": "a.together-path", "dimension": "grouping", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The verified call path shares one frame.", "check": { "check": "together", "elements": ["e.generate", "e.collect", "e.price", "e.tax", "e.publish"], "why": "one call path, one diagram" } },
    { "id": "a.together-lld", "dimension": "grouping", "severity": "minor", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The low-level details sit together.", "check": { "check": "together", "elements": ["e.invoice-draft", "e.transaction"], "why": "the LLD the source gives belongs in one place" } },
    { "id": "a.apart-boundary", "dimension": "grouping", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The interpretation is not mixed into the verified diagram.", "check": { "check": "apart", "elements": ["e.pricing-boundary", "e.price"], "why": "an interpretation inside the verified diagram reads as a code fact" } },
    { "id": "a.apart-questions", "dimension": "grouping", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "Open questions are not in the verified diagram.", "check": { "check": "apart", "elements": ["e.open-questions", "e.generate"], "why": "unknowns are not part of the verified path" } },
    { "id": "a.hierarchy", "dimension": "grouping", "severity": "minor", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The called functions hang off the entry point.", "check": { "check": "hierarchy", "main": "e.generate", "supporting": ["e.collect", "e.price", "e.tax", "e.publish"], "why": "the entry point orchestrates the path" } },
    { "id": "a.in-frame-draft", "dimension": "grouping", "severity": "minor", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The data contract sits in the LLD frame.", "check": { "check": "element_in_frame", "element": "e.invoice-draft", "frame": "f.structure" } },
    { "id": "a.in-frame-boundary", "dimension": "grouping", "severity": "minor", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The interpretation sits in the interpretation frame.", "check": { "check": "element_in_frame", "element": "e.pricing-boundary", "frame": "f.reading" } },

    { "id": "a.layout", "dimension": "visual", "severity": "critical", "method": "deterministic", "target": "render", "support": "implemented", "description": "No fatal layout issue (no link runs through a card).", "check": { "check": "layout_no_fatal" } },
    { "id": "a.no-overlap", "dimension": "visual", "severity": "major", "method": "deterministic", "target": "render", "support": "implemented", "description": "Cards and shapes don't overlap.", "check": { "check": "cards_no_overlap" } },
    { "id": "a.inside-frames", "dimension": "visual", "severity": "major", "method": "deterministic", "target": "render", "support": "implemented", "description": "Frames are large enough for their members.", "check": { "check": "children_inside_frames" } },

    { "id": "a.cites", "dimension": "traceability", "severity": "critical", "method": "deterministic", "target": "plan", "support": "future", "requires": ["ai.cites"], "description": "Every shape, card and edge cites its units: generate u12–u14 (+u15–u19 for the order); collect u20–u23; price u24–u26 and the hedge u27–u29; tax u30–u35; transaction u36–u38; publish u39–u43; draft u44–u47; boundary u48–u49; open questions u52, u54, u55; takeaway u56–u57. The inferred edge cites u27–u29 only." },
    { "id": "a.accounting", "dimension": "coverage", "severity": "critical", "method": "deterministic", "target": "plan", "support": "future", "requires": ["ai.unit-accounting", "ai.source-unit-ids"], "description": "Every unit is Represented except u2, u3 (meta) and u53 (duplicate of u27), which are Intentionally omitted with those reasons." },
    { "id": "a.review-flags", "dimension": "traceability", "severity": "major", "method": "deterministic", "target": "plan", "support": "future", "requires": ["ai.review-queue"], "description": "The inferred discounts edge, the pricing-boundary interpretation and the four unknowns (tax retries, publish failure, monthly trigger, topic owner) are in Needs review; no verified component is." },

    { "id": "a.judge-certainty", "dimension": "source_fidelity", "severity": "critical", "method": "human", "target": "plan", "support": "implemented", "description": "A reader can tell verified facts, interpretation, inference and unknowns apart.", "judge": { "question": "For each component, edge and card, can you tell whether it is a verified code fact, the author's interpretation, an unconfirmed inference or an unknown? Is any of them promoted to a stronger category than the source gives it?", "pass": "Verified facts carry files and symbols; the boundary reads as the author's reading; the discounts edge reads as unconfirmed; tax retries, publish recovery, the monthly trigger and the topic owner read as unknown.", "fail": "The discounts read is drawn as a plain 'reads', the boundary is presented as enforced, or any unknown is filled in (a retry policy, a scheduler, a recovery job)." } },
    { "id": "a.judge-lld", "dimension": "element_selection", "severity": "major", "method": "model_judge", "target": "plan", "support": "implemented", "description": "LLD detail appears only where the source gives it.", "judge": { "question": "Does the canvas show low-level detail (code, line ranges, field lists) only where the source provides it, and use plain text elsewhere?", "pass": "Only InvoiceDraft is code; line ranges appear only for generateInvoice (12–58) and the write (44–52); BillingPeriod and PricedLine are not expanded.", "fail": "Code is invented for functions the source only describes, line ranges are added for other files, or unread types are spelled out." } }
  ]
}
