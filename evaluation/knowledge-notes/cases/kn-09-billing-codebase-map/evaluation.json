    { "id": "a.module-paths", "dimension": "traceability", "severity": "minor", "method": "deterministic", "target": "plan", "support": "implemented", "description": "All five module paths are on the module map.", "check": { "check": "text_present", "element": "e.modules", "all": [["billing/invoices"], ["billing/usage"], ["billing/pricing"], ["billing/tax"], ["billing/events"]], "why": "protected paths (u5–u9)" } },

    { "id": "a.draft-code", "dimension": "element_selection", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The InvoiceDraft snippet is a code element, with its fields exact.", "check": { "check": "text_present", "element": "e.invoice-draft", "all": [["subtotalcents: number"], ["taxcents?: number"]], "why": "the only LLD the source gives as code (u45); an optional field must stay optional" } },
    { "id": "a.transaction-detail", "dimension": "source_fidelity", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The write's line range and all-or-nothing condition survive.", "check": { "check": "text_present", "element": "e.transaction", "all": [["44-52"], ["one transaction", "single transaction", "same transaction", "one database transaction"]], "why": "u36, u37" } },
    { "id": "a.tax-timeout", "dimension": "source_fidelity", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The 8-second timeout stays exact on the tax client.", "check": { "check": "text_present", "element": "e.tax", "all": [["8 seconds", "8 s ", "8s", "8-second", "8000 ms"]], "why": "protected number (u31)" } },
    { "id": "a.tax-retries-unknown", "dimension": "source_fidelity", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "regression": "invented_detail", "description": "The tax client's retry behaviour is shown as unknown, on the tax client itself.", "check": { "check": "text_present", "element": "e.tax", "all": [["retr"], ["unknown", "not documented", "undocumented", "not known"]], "why": "u34: retry behaviour is not documented; the unknown limits the tax client and stays on it" } },
    { "id": "a.no-retry-policy", "dimension": "source_fidelity", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "regression": "invented_detail", "description": "No retry policy is invented.", "check": { "check": "text_absent", "pattern": "exponential|back-?off|jitter|retr(?:y|ies|ied|ying)\\b[^.;\\n]{0,40}?\\b\\d+\\s*(?:x\\b|times|attempts)|\\b\\d+\\s*(?:retries|retry attempts|attempts)\\b|retries (?:up to|until)", "why": "the source says retry behaviour is not documented and quote() has no retry code (u34, u35)" } },
    { "id": "a.publish-failure-unknown", "dimension": "source_fidelity", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The publisher shows that failure recovery is unknown.", "check": { "check": "text_present", "element": "e.publish", "all": [["fail"], ["unknown", "no re-send", "no resend", "not found", "no job"]], "why": "u42, u43: an invoice can exist without its event and no recovery is known" } },
    { "id": "a.discount-hedged", "dimension": "source_fidelity", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The discounts read is on the pricing component, marked as unconfirmed.", "check": { "check": "text_present", "element": "e.price", "all": [["discount"], ["unconfirmed", "not confirmed", "probably", "possibly", "unverified", "may "]], "why": "u27–u29: an inferred relationship must be shown hedged" } },
    { "id": "a.no-confident-discount", "dimension": "source_fidelity", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "regression": "mislabeled_architecture_edge", "description": "Nothing states the discounts read as a fact (an edge label or card saying 'reads discounts' without a hedge).", "check": { "check": "text_absent", "pattern": "(?<!(?:probably|maybe|may|might|possibly|likely)(?: also)? )\\b(?:reads?|queries|uses|applies|loads)(?: also)? (?:the )?discounts?\\b", "why": "the source only says probably; the call site was not found (u27, u28)" } },
    { "id": "a.boundary-is-reading", "dimension": "source_fidelity", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The pricing boundary is marked as the author's interpretation, not an enforced rule.", "check": { "check": "text_present", "element": "e.pricing-boundary", "all": [["interpret", "reading", "in effect", "author"], ["not enforced", "not a rule", "does not enforce", "doesn't enforce", "nothing stops", "nothing in the code stops", "not enforce"]], "why": "u48, u49: interpretation, not a code fact" } },
    { "id": "a.no-enforced-boundary", "dimension": "source_fidelity", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "No claim that the code enforces the pricing boundary.", "check": { "check": "text_absent", "pattern": "(?<!not |never |n't )\\benforces? (?:the |a )?pricing boundary|pricing boundary (?:is|was) enforced", "why": "u49: nothing enforces it" } },
    { "id": "a.no-fabricated-path", "dimension": "source_fidelity", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "regression": "invented_detail", "description": "No plausible but unstated path is invented (a retry helper, a discounts module, a scheduler or jobs folder).", "check": { "check": "text_absent", "pattern": "billing/(?:tax/retr|discounts?/|discounts?\\.ts|jobs?/|scheduler|cron|invoices/schedule)", "why": "the source never states these paths; the scheduler and the discounts call site were not found (u28, u52)" } },

    { "id": "a.kind-tables", "dimension": "element_selection", "severity": "minor", "method": "deterministic", "target": "plan", "support": "implemented", "description": "Tables are drawn as data stores.", "check": { "check": "element_kind", "element": "e.usage-events", "kinds": ["database", "store"] } },
    { "id": "a.kind-topic", "dimension": "element_selection", "severity": "minor", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The topic is drawn as a message bus.", "check": { "check": "element_kind", "element": "e.topic", "kinds": ["messagebus", "event"] } },
    { "id": "a.kind-taxwell", "dimension": "element_selection", "severity": "minor", "method": "deterministic", "target": "plan", "support": "implemented", "description": "Taxwell is drawn as an external system.", "check": { "check": "element_kind", "element": "e.taxwell", "kinds": ["external", "cloud"] } },
    { "id": "a.kind-generate", "dimension": "element_selection", "severity": "minor", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The entry point is drawn as a function.", "check": { "check": "element_kind", "element": "e.generate", "kinds": ["function", "backend", "endpoint"] } },

    { "id": "a.rel-generate-collect", "dimension": "relationships", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "generateInvoice calls collectUsage (labelled).", "check": { "check": "relationship_present", "relationship": "r.generate-collect" } },
    { "id": "a.rel-generate-price", "dimension": "relationships", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "generateInvoice calls priceUsage (labelled).", "check": { "check": "relationship_present", "relationship": "r.generate-price" } },
