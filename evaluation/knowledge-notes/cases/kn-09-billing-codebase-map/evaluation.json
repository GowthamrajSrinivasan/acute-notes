    { "id": "a.path-generate", "dimension": "traceability", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The entry point carries its file and line range.", "check": { "check": "text_present", "element": "e.generate", "all": [["billing/invoices/generate.ts"], ["12-58", "12 to 58", "l12"]], "why": "component-to-file mapping with its line range (u12)" } },
