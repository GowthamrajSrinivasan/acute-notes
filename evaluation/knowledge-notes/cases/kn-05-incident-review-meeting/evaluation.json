{
  "datasetVersion": "1.0.0",
  "caseId": "kn-05-incident-review-meeting",
  "assertions": [
    { "id": "a.incident", "dimension": "coverage", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The cause of the outage is on the canvas.", "check": { "check": "element_present", "element": "e.incident" } },
    { "id": "a.incident-figures", "dimension": "source_fidelity", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "description": "Start time, duration and failed checkouts are exact.", "check": { "check": "text_present", "element": "e.incident", "all": [["16:40"], ["47 minutes", "47 min"], ["2300"]], "why": "protected figures (u7, u13, u14)" } },
    { "id": "a.pool-values", "dimension": "source_fidelity", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The pool sizes are exact.", "check": { "check": "text_present", "element": "e.incident", "all": [["50"], ["55"]], "why": "the typo's values (u8, u9)" } },
    { "id": "a.alert-gap", "dimension": "coverage", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "Why detection was slow is on the canvas.", "check": { "check": "element_present", "element": "e.alert-gap" } },
    { "id": "a.status-gap", "dimension": "coverage", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The late status page is on the canvas.", "check": { "check": "element_present", "element": "e.status-gap" } },
    { "id": "a.config-gap", "dimension": "coverage", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The review gap for config is on the canvas.", "check": { "check": "element_present", "element": "e.config-gap" } },
    { "id": "a.decision-alert", "dimension": "coverage", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The agreed alert threshold is on the canvas.", "check": { "check": "element_present", "element": "e.decision-alert" } },
    { "id": "a.decision-status-page", "dimension": "coverage", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The agreed status-page change is on the canvas.", "check": { "check": "element_present", "element": "e.decision-status-page" } },
    { "id": "a.decision-config", "dimension": "coverage", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The agreed config review is on the canvas.", "check": { "check": "element_present", "element": "e.decision-config" } },
    { "id": "a.freeze-proposal", "dimension": "coverage", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The freeze proposal is kept.", "check": { "check": "element_present", "element": "e.freeze-proposal" } },
    { "id": "a.freeze-undecided", "dimension": "source_fidelity", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "regression": "fabricated_agreement", "description": "The freeze card says it was not agreed or decided.", "check": { "check": "text_present", "element": "e.freeze-proposal", "all": [["not agreed", "no agreement", "not decided", "undecided", "without agreement", "parked"]], "why": "the freeze was explicitly not decided (u55, u62)" } },
    { "id": "a.freeze-disagreement", "dimension": "source_fidelity", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The disagreement stays on the freeze card.", "check": { "check": "text_present", "element": "e.freeze-proposal", "all": [["leila"], ["monday", "moves the risk", "missing review", "review, not the day"]], "why": "Leila's objection (u55–u57) qualifies the proposal" } },
    { "id": "a.rollback-proposal", "dimension": "coverage", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The auto-rollback proposal is kept.", "check": { "check": "element_present", "element": "e.rollback-proposal" } },
    { "id": "a.rollback-open", "dimension": "source_fidelity", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "regression": "fabricated_agreement", "description": "The auto-rollback card says it is still open.", "check": { "check": "text_present", "element": "e.rollback-proposal", "all": [["open", "undecided", "not decided", "unresolved", "not agreed"]], "why": "auto-rollback was left open (u71, u73)" } },
    { "id": "a.retry-question", "dimension": "coverage", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The retry question is preserved.", "check": { "check": "element_present", "element": "e.retry-question" } },
    { "id": "a.retry-unknown", "dimension": "source_fidelity", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The retry question is shown as unanswered.", "check": { "check": "text_present", "element": "e.retry-question", "all": [["nobody knows", "unknown", "not known", "no one has", "nobody has", "not yet"]], "why": "nobody has checked the logs (u77)" } },
    { "id": "a.actions", "dimension": "element_selection", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The action items are a checklist naming their owners.", "check": { "check": "element_present", "element": "e.actions" } },
    { "id": "a.action-alert-deadline", "dimension": "source_fidelity", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "regression": "condition_dropped", "description": "Marcus's item keeps its deadline.", "check": { "check": "text_present", "element": "e.actions", "all": [["marcus"], ["march 19"]], "why": "owner and deadline stated (u29)" } },
    { "id": "a.action-config-deadline", "dimension": "source_fidelity", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "regression": "condition_dropped", "description": "Leila's item keeps its deadline.", "check": { "check": "text_present", "element": "e.actions", "all": [["leila"], ["march 21"]], "why": "owner and deadline stated (u51)" } },
    { "id": "a.action-freeze-data", "dimension": "source_fidelity", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "description": "Tomás's item keeps its review date.", "check": { "check": "text_present", "element": "e.actions", "all": [["tomás", "tomas"], ["april 2"]], "why": "owner and date stated (u63–u65)" } },
    { "id": "a.action-email-owner", "dimension": "source_fidelity", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "regression": "critical_exception_omitted", "description": "Kenji's email item keeps its owner.", "check": { "check": "text_present", "element": "e.actions", "all": [["kenji"], ["email"]], "why": "owner stated (u79, u80)" } },
    { "id": "a.no-email-deadline", "dimension": "source_fidelity", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "regression": "invented_detail", "description": "No deadline is invented for the customer email.", "check": { "check": "text_absent", "pattern": "customer email[^;]{0,30}?\\b(by|due|before|deadline:?) (mon|tue|wed|thu|fri|sat|sun|jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec|end|eod|tomorrow|next|this|\\d)", "why": "no deadline was stated for the email (u79, u80)" } },
    { "id": "a.no-fabricated-agreement", "dimension": "source_fidelity", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "regression": "fabricated_agreement", "description": "Nothing says the freeze or auto-rollback was agreed.", "check": { "check": "text_absent", "pattern": "\\b(agreed|decided|approved)[:,]? (that )?(we('ll| will) )?(to )?(a |the )?(friday |late-friday )?(deploy(ment)? )?(freeze|stop deploying|no (payments )?deploys|automatic rollback|auto-rollback|roll back automatically)|\\b(freeze|auto-rollback|automatic rollback)[^.]{0,40}\\b(was|is|has been|were) (agreed|approved|decided)\\b", "why": "both were proposals without agreement (u55, u62, u71)" } },
    { "id": "a.frame-decisions", "dimension": "grouping", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "description": "Agreed decisions have their own frame.", "check": { "check": "frame_present", "frame": "f.decisions" } },
    { "id": "a.frame-proposals", "dimension": "grouping", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "description": "Unagreed proposals have their own frame.", "check": { "check": "frame_present", "frame": "f.proposals" } },
    { "id": "a.frame-what-happened", "dimension": "grouping", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The findings have a frame.", "check": { "check": "frame_present", "frame": "f.what-happened" } },
    { "id": "a.frame-actions", "dimension": "grouping", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "Action items have a frame.", "check": { "check": "frame_present", "frame": "f.actions" } },
    { "id": "a.frame-open-questions", "dimension": "grouping", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "Open questions have a frame.", "check": { "check": "frame_present", "frame": "f.open-questions" } },
    { "id": "a.frame-count", "dimension": "grouping", "severity": "minor", "method": "deterministic", "target": "plan", "support": "implemented", "description": "A handful of outcome frames, not one per speaker turn.", "check": { "check": "frame_count", "min": 3, "max": 7 } },
    { "id": "a.incident-in-frame", "dimension": "grouping", "severity": "minor", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The incident sits with the findings.", "check": { "check": "element_in_frame", "element": "e.incident", "frame": "f.what-happened" } },
    { "id": "a.alert-gap-in-frame", "dimension": "grouping", "severity": "minor", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The alert finding sits with the findings.", "check": { "check": "element_in_frame", "element": "e.alert-gap", "frame": "f.what-happened" } },
    { "id": "a.status-gap-in-frame", "dimension": "grouping", "severity": "minor", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The status-page finding sits with the findings.", "check": { "check": "element_in_frame", "element": "e.status-gap", "frame": "f.what-happened" } },
    { "id": "a.config-gap-in-frame", "dimension": "grouping", "severity": "minor", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The config finding sits with the findings.", "check": { "check": "element_in_frame", "element": "e.config-gap", "frame": "f.what-happened" } },
    { "id": "a.decision-alert-in-frame", "dimension": "grouping", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The alert decision sits in the decisions frame.", "check": { "check": "element_in_frame", "element": "e.decision-alert", "frame": "f.decisions" } },
    { "id": "a.decision-status-in-frame", "dimension": "grouping", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The status-page decision sits in the decisions frame.", "check": { "check": "element_in_frame", "element": "e.decision-status-page", "frame": "f.decisions" } },
    { "id": "a.decision-config-in-frame", "dimension": "grouping", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The config decision sits in the decisions frame.", "check": { "check": "element_in_frame", "element": "e.decision-config", "frame": "f.decisions" } },
    { "id": "a.freeze-in-frame", "dimension": "grouping", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The freeze sits in the proposals frame.", "check": { "check": "element_in_frame", "element": "e.freeze-proposal", "frame": "f.proposals" } },
    { "id": "a.actions-in-frame", "dimension": "grouping", "severity": "minor", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The checklist sits in the action-items frame.", "check": { "check": "element_in_frame", "element": "e.actions", "frame": "f.actions" } },
    { "id": "a.retry-in-frame", "dimension": "grouping", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The retry question sits with the open questions.", "check": { "check": "element_in_frame", "element": "e.retry-question", "frame": "f.open-questions" } },
    { "id": "a.decisions-together", "dimension": "grouping", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The three agreements share one frame.", "check": { "check": "together", "elements": ["e.decision-alert", "e.decision-status-page", "e.decision-config"], "why": "one trustworthy list of what was agreed" } },
    { "id": "a.config-apart-freeze", "dimension": "grouping", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "regression": "fabricated_agreement", "description": "The config decision and the freeze proposal never share a frame.", "check": { "check": "apart", "elements": ["e.decision-config", "e.freeze-proposal"], "why": "a disputed proposal beside agreed decisions reads as agreed" } },
    { "id": "a.alert-apart-freeze", "dimension": "grouping", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The alert decision and the freeze proposal never share a frame.", "check": { "check": "apart", "elements": ["e.decision-alert", "e.freeze-proposal"], "why": "decisions vs proposals" } },
    { "id": "a.alert-apart-rollback", "dimension": "grouping", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The alert decision and auto-rollback never share a frame.", "check": { "check": "apart", "elements": ["e.decision-alert", "e.rollback-proposal"], "why": "only the threshold was agreed" } },
    { "id": "a.config-apart-rollback", "dimension": "grouping", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The config decision and auto-rollback never share a frame.", "check": { "check": "apart", "elements": ["e.decision-config", "e.rollback-proposal"], "why": "auto-rollback for config was only floated" } },
    { "id": "a.hierarchy-alert", "dimension": "grouping", "severity": "minor", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The alert finding hangs off the decision and is not weighted above it.", "check": { "check": "hierarchy", "main": "e.decision-alert", "supporting": ["e.alert-gap"], "why": "the finding explains the decision" } },
    { "id": "a.rel-alert", "dimension": "relationships", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The alert decision is linked to the finding it answers.", "check": { "check": "relationship_present", "relationship": "r.alert-decision-from-gap" } },
    { "id": "a.rel-config", "dimension": "relationships", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The config decision is linked to the review gap.", "check": { "check": "relationship_present", "relationship": "r.config-decision-from-gap" } },
    { "id": "a.rel-status", "dimension": "relationships", "severity": "minor", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The status-page decision is linked to the late status page (optional).", "check": { "check": "relationship_present", "relationship": "r.status-decision-from-gap" } },
    { "id": "a.layout", "dimension": "visual", "severity": "critical", "method": "deterministic", "target": "render", "support": "implemented", "description": "No link runs through a card.", "check": { "check": "layout_no_fatal" } },
    { "id": "a.no-overlap", "dimension": "visual", "severity": "major", "method": "deterministic", "target": "render", "support": "implemented", "description": "Cards don't overlap.", "check": { "check": "cards_no_overlap" } },
    { "id": "a.inside-frames", "dimension": "visual", "severity": "major", "method": "deterministic", "target": "render", "support": "implemented", "description": "Frames are large enough for their cards.", "check": { "check": "children_inside_frames" } },
    { "id": "a.cites", "dimension": "traceability", "severity": "critical", "method": "deterministic", "target": "plan", "support": "future", "requires": ["ai.cites"], "description": "Every card cites its turns: incident u5, u7–u15; findings u17–u21, u31–u35, u41–u44; decisions u23–u27, u36–u39, u45–u49; proposals u53–u62, u66–u73; actions u28–u29, u50–u51, u63–u65, u79–u80; question u75–u78." },
    { "id": "a.accounting", "dimension": "coverage", "severity": "critical", "method": "deterministic", "target": "plan", "support": "future", "requires": ["ai.unit-accounting", "ai.source-unit-ids"], "description": "Filler (u2–u4, u82), meta (u1, u6, u16, u22, u30, u33, u40, u52, u74) and the repeated timeline (u81, duplicate of u12) are Intentionally omitted; every other unit, and every critical one, is Represented." },
    { "id": "a.judge-decisions-vs-proposals", "dimension": "source_fidelity", "severity": "critical", "method": "model_judge", "target": "plan", "support": "implemented", "regression": "fabricated_agreement", "description": "Decisions and proposals are told apart.", "judge": { "question": "Would a reader who missed the meeting know exactly which three things were agreed and that the freeze and auto-rollback were not? Does any wording soften a proposal into a plan ('we'll look at a freeze', 'moving to auto-rollback')?", "pass": "Agreed items say so; both proposals carry their objection and an explicit not-agreed / open status.", "fail": "A proposal is listed with the decisions, or its status is missing or hedged into agreement." } },
    { "id": "a.judge-owners-dates", "dimension": "source_fidelity", "severity": "critical", "method": "human", "target": "plan", "support": "implemented", "description": "Each action item keeps its own owner and date, and nothing is invented.", "judge": { "question": "Compare each checklist item with the transcript. Is every owner paired with the right task and the right date, and does the email item have no date?", "pass": "Marcus–March 19, Leila–March 21, Tomás–April 2 (next review), Kenji–no date; no extra owners or dates.", "fail": "A date is moved to the wrong owner, dropped, or added to Kenji's email; or the status-page decision gets an invented owner." } }
  ]
}
