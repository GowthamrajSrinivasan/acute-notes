{
  "datasetVersion": "1.0.0",
  "caseId": "kn-06-hybrid-search-reranking",
  "assertions": [
    { "id": "a.rag-bound", "dimension": "coverage", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The main claim (the answer is bounded by retrieval) is on the canvas.", "check": { "check": "element_present", "element": "e.rag-bound" } },
    { "id": "a.bm25", "dimension": "coverage", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The BM25 signal is on the canvas.", "check": { "check": "element_present", "element": "e.bm25" } },
    { "id": "a.vector", "dimension": "coverage", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The embedding signal is on the canvas.", "check": { "check": "element_present", "element": "e.vector" } },
    { "id": "a.hybrid", "dimension": "coverage", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "description": "Hybrid search is on the canvas.", "check": { "check": "element_present", "element": "e.hybrid" } },
    { "id": "a.rrf", "dimension": "coverage", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "description": "RRF with its formula is on the canvas.", "check": { "check": "element_present", "element": "e.rrf" } },
    { "id": "a.candidates", "dimension": "coverage", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "Candidate generation (top 50 each) is on the canvas.", "check": { "check": "element_present", "element": "e.candidates" } },
    { "id": "a.cross-encoder", "dimension": "coverage", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The cross-encoder step is on the canvas.", "check": { "check": "element_present", "element": "e.cross-encoder" } },
    { "id": "a.rerank", "dimension": "coverage", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "description": "What reranking buys is on the canvas.", "check": { "check": "element_present", "element": "e.rerank" } },
    { "id": "a.generation", "dimension": "coverage", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "description": "Generation from the top passages, with citations, is on the canvas.", "check": { "check": "element_present", "element": "e.generation" } },
    { "id": "a.example", "dimension": "coverage", "severity": "minor", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The E-4012 example is kept.", "check": { "check": "element_present", "element": "e.example" } },
    { "id": "a.latency", "dimension": "coverage", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "description": "Reranking's latency price is on the canvas.", "check": { "check": "element_present", "element": "e.rerank-latency" } },
    { "id": "a.summary", "dimension": "coverage", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The takeaway appears (as a card or a frame takeaway).", "check": { "check": "element_present", "element": "e.summary" } },
    { "id": "a.table", "dimension": "element_selection", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The four-configuration measurement is a table, not prose.", "check": { "check": "element_present", "element": "e.tradeoff-table" } },

    { "id": "a.complementary-with-hybrid", "dimension": "source_fidelity", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "regression": "condition_dropped", "description": "The complementary-signals condition sits on the hybrid-search card itself.", "check": { "check": "text_present", "element": "e.hybrid", "all": [["complementary", "the other misses", "other one misses", "the other doesn't find", "the other does not find"]], "why": "hybrid search can improve recall only when the signals are complementary (u17)" } },
    { "id": "a.hybrid-hedged", "dimension": "source_fidelity", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "regression": "possibility_to_guarantee", "description": "The hybrid claim stays a possibility.", "check": { "check": "text_present", "element": "e.hybrid", "all": [["can improve", "may improve", "can raise", "may raise", "can increase", "may increase", "can help", "may help", "can boost"]], "why": "the source says 'can improve recall', not 'improves'" } },
    { "id": "a.no-always", "dimension": "source_fidelity", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "regression": "possibility_to_guarantee", "description": "No absolute the source doesn't make.", "check": { "check": "text_absent", "pattern": "\\b(always|invariably|in every case|in all cases)\\b", "why": "every benefit in the source is conditional" } },
    { "id": "a.no-rerank-guarantee", "dimension": "source_fidelity", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "regression": "possibility_to_guarantee", "description": "Nothing claims a guarantee; only negated mentions ('does not guarantee') are allowed.", "check": { "check": "text_absent", "pattern": "(?<!(?:not|n't|never|no|cannot|can't) )guarantee", "why": "the source says reranking does not guarantee a correct answer (u31)" } },
    { "id": "a.rerank-not-correctness", "dimension": "source_fidelity", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "regression": "possibility_to_guarantee", "description": "The reranking card says precision is not correctness.", "check": { "check": "text_present", "element": "e.rerank", "all": [["not guarantee", "n't guarantee", "no guarantee", "not make the answer correct", "not ensure", "n't ensure", "not the same as correct", "not correctness"]], "why": "reranking improves precision but does not guarantee the answer is correct (u31)" } },
    { "id": "a.rerank-limit-with-claim", "dimension": "source_fidelity", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "regression": "critical_exception_omitted", "description": "The 'can only reorder what retrieval found' limit sits on the reranking card.", "check": { "check": "text_present", "element": "e.rerank", "all": [["only reorder", "cannot recover", "can't recover", "not among the candidates", "never retrieved", "retrieval missed"]], "why": "a passage missing from the candidates can't be recovered by reranking (u32)" } },
    { "id": "a.no-rerank-recall", "dimension": "source_fidelity", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "regression": "invented_detail", "description": "Reranking is never said to improve recall or find missed passages.", "check": { "check": "text_absent", "pattern": "rerank(?:ing|er)? (?:improves|increases|raises|boosts) recall|rerank(?:ing|er)? (?:finds|recovers) (?:missed|missing)", "why": "the reranker can only reorder the candidates (u32)" } },
    { "id": "a.rrf-formula", "dimension": "source_fidelity", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The fusion formula survives exactly.", "check": { "check": "text_present", "element": "e.rrf", "all": [["1/(k + rank)", "1/(k+rank)", "1 / (k + rank)"]], "why": "protected formula (u21)" } },
    { "id": "a.k60", "dimension": "source_fidelity", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "description": "k = 60 survives exactly.", "check": { "check": "text_present", "element": "e.rrf", "all": [["k = 60", "k=60", "k is 60", "k of 60"]], "why": "protected constant (u22)" } },
    { "id": "a.candidate-budget", "dimension": "source_fidelity", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The fused list's size (at most 100) survives.", "check": { "check": "text_present", "element": "e.candidates", "all": [["100"]], "why": "protected number (u23)" } },
    { "id": "a.top8", "dimension": "source_fidelity", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The reranker's output size (top 8) survives on the cross-encoder card.", "check": { "check": "text_present", "element": "e.cross-encoder", "all": [["top 8", "8 passages", "eight passages", "best 8"]], "why": "protected number (u30)" } },
    { "id": "a.latency-120", "dimension": "source_fidelity", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The 120 ms figure survives exactly.", "check": { "check": "text_present", "element": "e.rerank-latency", "all": [["120 ms", "120ms", "120 milliseconds"]], "why": "protected number (u41)" } },
    { "id": "a.figures-caveat-with-claim", "dimension": "source_fidelity", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "regression": "condition_dropped", "description": "The 'one collection, one query set' caveat sits on the latency card.", "check": { "check": "text_present", "element": "e.rerank-latency", "all": [["one collection", "single collection", "one query set", "this collection"]], "why": "the figures don't generalise as they stand (u42)" } },
    { "id": "a.table-values", "dimension": "source_fidelity", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The table keeps its numbers.", "check": { "check": "text_present", "element": "e.tradeoff-table", "all": [["61%"], ["68%"], ["79%"], ["88%"], ["35 ms"], ["190 ms"], ["0.95"]], "why": "protected numbers (u40)" } },
    { "id": "a.bm25-limit-with-claim", "dimension": "source_fidelity", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "regression": "critical_exception_omitted", "description": "BM25's vocabulary-mismatch weakness sits on the BM25 card.", "check": { "check": "text_present", "element": "e.bm25", "all": [["vocabulary mismatch", "different words", "synonym", "same words", "won't match", "will not match"]], "why": "u9 limits the BM25 claim" } },
    { "id": "a.vector-limit-with-claim", "dimension": "source_fidelity", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "regression": "critical_exception_omitted", "description": "The exact-code weakness sits on the embeddings card.", "check": { "check": "text_present", "element": "e.vector", "all": [["exact code", "identifier", "e-4021", "error code"]], "why": "u12–u14 limit the embedding claim" } },

    { "id": "a.frame-retrieval", "dimension": "grouping", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "A frame for the retrieval signals.", "check": { "check": "frame_present", "frame": "f.retrieval" } },
    { "id": "a.frame-fusion", "dimension": "grouping", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "A frame for fusion and candidates.", "check": { "check": "frame_present", "frame": "f.fusion" } },
    { "id": "a.frame-reranking", "dimension": "grouping", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "description": "Reranking has a frame of its own.", "check": { "check": "frame_present", "frame": "f.reranking" } },
    { "id": "a.frame-generation", "dimension": "grouping", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "A frame for generation.", "check": { "check": "frame_present", "frame": "f.generation" } },
    { "id": "a.frame-tradeoffs", "dimension": "grouping", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "A frame for relevance, latency and cost.", "check": { "check": "frame_present", "frame": "f.tradeoffs" } },
    { "id": "a.frame-count", "dimension": "grouping", "severity": "minor", "method": "deterministic", "target": "plan", "support": "implemented", "description": "One frame per subject area: neither one big frame nor one per sentence.", "check": { "check": "frame_count", "min": 4, "max": 7 } },
    { "id": "a.together-signals", "dimension": "grouping", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "BM25 and embeddings side by side.", "check": { "check": "together", "elements": ["e.bm25", "e.vector"], "why": "the two signals are compared" } },
    { "id": "a.together-fusion", "dimension": "grouping", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "Hybrid, RRF and candidates share a frame.", "check": { "check": "together", "elements": ["e.hybrid", "e.rrf", "e.candidates"], "why": "one merge step" } },
    { "id": "a.together-rerank", "dimension": "grouping", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The cross-encoder and the reranking claim share a frame.", "check": { "check": "together", "elements": ["e.cross-encoder", "e.rerank"], "why": "the step and what it buys" } },
    { "id": "a.together-generation", "dimension": "grouping", "severity": "minor", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The example sits with generation.", "check": { "check": "together", "elements": ["e.generation", "e.example"], "why": "the example ends in a generated answer" } },
    { "id": "a.apart-rerank-bm25", "dimension": "grouping", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "Reranking is kept apart from the retrievers.", "check": { "check": "apart", "elements": ["e.rerank", "e.bm25"], "why": "reranking reorders; it doesn't retrieve" } },
    { "id": "a.apart-cross-vector", "dimension": "grouping", "severity": "minor", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The cross-encoder is not grouped with the embedding retriever.", "check": { "check": "apart", "elements": ["e.cross-encoder", "e.vector"], "why": "one rescoring model, one retrieval model" } },
    { "id": "a.hierarchy-example", "dimension": "grouping", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The example hangs off generation and is not weighted above it.", "check": { "check": "hierarchy", "main": "e.generation", "supporting": ["e.example"], "why": "an example is supporting detail" } },
    { "id": "a.in-frame-bm25", "dimension": "grouping", "severity": "minor", "method": "deterministic", "target": "plan", "support": "implemented", "description": "BM25 sits in the retrieval frame.", "check": { "check": "element_in_frame", "element": "e.bm25", "frame": "f.retrieval" } },
    { "id": "a.in-frame-hybrid", "dimension": "grouping", "severity": "minor", "method": "deterministic", "target": "plan", "support": "implemented", "description": "Hybrid search sits in the fusion frame.", "check": { "check": "element_in_frame", "element": "e.hybrid", "frame": "f.fusion" } },
    { "id": "a.in-frame-rerank", "dimension": "grouping", "severity": "minor", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The reranking claim sits in the reranking frame.", "check": { "check": "element_in_frame", "element": "e.rerank", "frame": "f.reranking" } },
    { "id": "a.in-frame-rag-bound", "dimension": "grouping", "severity": "minor", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The main claim sits in the generation frame.", "check": { "check": "element_in_frame", "element": "e.rag-bound", "frame": "f.generation" } },
    { "id": "a.in-frame-table", "dimension": "grouping", "severity": "minor", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The table sits in the trade-offs frame.", "check": { "check": "element_in_frame", "element": "e.tradeoff-table", "frame": "f.tradeoffs" } },
    { "id": "a.in-frame-latency", "dimension": "grouping", "severity": "minor", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The latency card sits in the trade-offs frame.", "check": { "check": "element_in_frame", "element": "e.rerank-latency", "frame": "f.tradeoffs" } },

    { "id": "a.rel-bm25", "dimension": "relationships", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "BM25 flows into the candidates, labelled with its top 50.", "check": { "check": "relationship_present", "relationship": "r.bm25-candidates" } },
    { "id": "a.rel-vector", "dimension": "relationships", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "Vector retrieval flows into the candidates, labelled with its top 50.", "check": { "check": "relationship_present", "relationship": "r.vector-candidates" } },
    { "id": "a.rel-candidates-rerank", "dimension": "relationships", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "regression": "dependency_reversed", "description": "The fused candidates flow into the cross-encoder, labelled.", "check": { "check": "relationship_present", "relationship": "r.candidates-rerank" } },
    { "id": "a.rel-rerank-generation", "dimension": "relationships", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "regression": "dependency_reversed", "description": "The reranker hands the top 8 passages to generation, in that direction.", "check": { "check": "relationship_present", "relationship": "r.rerank-generation" } },
    { "id": "a.rel-example", "dimension": "relationships", "severity": "minor", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The example is linked to generation.", "check": { "check": "relationship_present", "relationship": "r.generation-example" } },
    { "id": "a.no-generation-to-retrieval", "dimension": "relationships", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "regression": "dependency_reversed", "description": "No link runs from generation back to a retriever.", "check": { "check": "relationship_absent", "from": "e.generation", "to": "e.bm25", "why": "the pipeline runs one way; the answer does not feed retrieval" } },
    { "id": "a.no-generation-to-rerank", "dimension": "relationships", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "regression": "dependency_reversed", "description": "No link runs from generation back to the reranker.", "check": { "check": "relationship_absent", "from": "e.generation", "to": "e.cross-encoder", "why": "the reranker feeds generation, not the other way round" } },

    { "id": "a.layout", "dimension": "visual", "severity": "critical", "method": "deterministic", "target": "render", "support": "implemented", "description": "No link runs through a card.", "check": { "check": "layout_no_fatal" } },
    { "id": "a.no-overlap", "dimension": "visual", "severity": "major", "method": "deterministic", "target": "render", "support": "implemented", "description": "Cards don't overlap.", "check": { "check": "cards_no_overlap" } },
    { "id": "a.inside-frames", "dimension": "visual", "severity": "major", "method": "deterministic", "target": "render", "support": "implemented", "description": "Frames are large enough for their cards.", "check": { "check": "children_inside_frames" } },
    { "id": "a.frames-apart", "dimension": "visual", "severity": "minor", "method": "deterministic", "target": "render", "support": "implemented", "description": "Frames don't overlap.", "check": { "check": "frames_no_overlap" } },

    { "id": "a.cites", "dimension": "traceability", "severity": "critical", "method": "deterministic", "target": "plan", "support": "future", "requires": ["ai.cites"], "description": "Every card cites its units (see canvas.json unsupported[ai.cites]); the hybrid card cites u17 and u18, the reranking card u31 and u32. No card cites a unit it doesn't represent." },
    { "id": "a.accounting", "dimension": "coverage", "severity": "critical", "method": "deterministic", "target": "plan", "support": "future", "requires": ["ai.unit-accounting", "ai.source-unit-ids"], "description": "All 45 units are accounted for: u3 may be Intentionally omitted (meta); every other unit is Represented, and every critical unit (u2, u9, u12, u17, u18, u21, u22, u31, u32, u35, u41, u42, u45) is Represented." },
    { "id": "a.review-queue", "dimension": "traceability", "severity": "minor", "method": "deterministic", "target": "plan", "support": "future", "requires": ["ai.review-queue"], "description": "Nothing in this source is ambiguous or conflicting, so the Needs review queue should stay empty; a card flagged for review here is a false alarm." },
    { "id": "a.judge-hedges", "dimension": "source_fidelity", "severity": "critical", "method": "model_judge", "target": "plan", "support": "implemented", "regression": "possibility_to_guarantee", "description": "Hedges and conditions keep their strength.", "judge": { "question": "Compare every card about hybrid search, reranking and the measured figures with the source. Is any 'can', 'when', 'may', 'does not guarantee' or 'from one collection' weakened, widened or dropped?", "pass": "Hybrid search 'can improve recall when the signals are complementary'; reranking 'improves precision but does not guarantee correctness' and 'can only reorder what retrieval found'; the figures are tied to one collection.", "fail": "Any card says hybrid search improves recall without the condition, that reranking makes answers correct or recovers missed passages, or presents the 88% / 120 ms figures as general." } },
    { "id": "a.judge-distilled", "dimension": "element_selection", "severity": "major", "method": "model_judge", "target": "plan", "support": "implemented", "description": "Cards are distilled, not copied, and titles state the point.", "judge": { "question": "Do card titles state the point ('Reranking sharpens the top results, not correctness') rather than name a topic ('Reranking'), and are bodies shorter than the sentences they cover without losing a number, formula or limit?", "pass": "Statement titles; compact bodies; every protected value kept.", "fail": "Topic titles, or near-verbatim copies of source paragraphs." } },
    { "id": "a.judge-pipeline", "dimension": "relationships", "severity": "major", "method": "human", "target": "plan", "support": "implemented", "description": "The pipeline reads in one direction with meaningful labels.", "judge": { "question": "Following the arrows, can a reader trace retrieval → candidates → reranking → generation, and does each label say what passes along (top 50, fused candidates, top 8)?", "pass": "One readable chain with quantity labels; no arrow suggests the answer feeds back into retrieval.", "fail": "Missing or reversed steps, unlabelled flows, or a loop from generation back to retrieval." } }
  ]
}
