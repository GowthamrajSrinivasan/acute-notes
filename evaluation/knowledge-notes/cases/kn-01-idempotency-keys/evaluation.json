{
  "datasetVersion": "1.0.0",
  "caseId": "kn-01-idempotency-keys",
  "assertions": [
    { "id": "a.definition", "dimension": "coverage", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The definition is on the canvas.", "check": { "check": "element_present", "element": "e.definition" } },
    { "id": "a.replay", "dimension": "coverage", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The replay mechanism is on the canvas.", "check": { "check": "element_present", "element": "e.replay" } },
    { "id": "a.example", "dimension": "coverage", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The worked example is kept.", "check": { "check": "element_present", "element": "e.example" } },
    { "id": "a.takeaway", "dimension": "coverage", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The bounded-window takeaway appears (as the frame's takeaway or a card).", "check": { "check": "element_present", "element": "e.takeaway" } },
    { "id": "a.window-with-claim", "dimension": "source_fidelity", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "regression": "condition_dropped", "description": "The 24-hour bound sits on the replay card itself.", "check": { "check": "text_present", "element": "e.replay", "all": [["24 hours", "24-hour", "24 h", "24h"]], "why": "the expiry window limits the replay claim and must stay with it" } },
    { "id": "a.reuse-with-claim", "dimension": "source_fidelity", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "regression": "critical_exception_omitted", "description": "The reused-key rejection sits on the replay card itself.", "check": { "check": "text_present", "element": "e.replay", "all": [["reject", "refuse", "error"], ["different amount", "different request", "different payload", "mismatch"]], "why": "a reused key with a different amount must be rejected (u8)" } },
    { "id": "a.no-absolute", "dimension": "source_fidelity", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "regression": "possibility_to_guarantee", "description": "No absolute claim the source doesn't make.", "check": { "check": "text_absent", "pattern": "\\b(always|forever|permanently|indefinitely|exactly[- ]once)\\b", "why": "the source bounds the protection; it never says always or exactly-once" } },
    { "id": "a.exact-key", "dimension": "source_fidelity", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The example's key value survives exactly.", "check": { "check": "text_present", "element": "e.example", "all": [["7f3c-91ab"]], "why": "protected identifier (u3, u5)" } },
    { "id": "a.frame", "dimension": "grouping", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "description": "One frame for the concept.", "check": { "check": "frame_present", "frame": "f.idempotency-keys" } },
    { "id": "a.frame-count", "dimension": "grouping", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "Nine sentences are not split across frames.", "check": { "check": "frame_count", "min": 1, "max": 1 } },
    { "id": "a.together", "dimension": "grouping", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "Definition, mechanism and example share the frame.", "check": { "check": "together", "elements": ["e.definition", "e.replay", "e.example"], "why": "one mechanism belongs in one frame" } },
    { "id": "a.in-frame-definition", "dimension": "grouping", "severity": "minor", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The definition sits in the frame.", "check": { "check": "element_in_frame", "element": "e.definition", "frame": "f.idempotency-keys" } },
    { "id": "a.in-frame-replay", "dimension": "grouping", "severity": "minor", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The mechanism sits in the frame.", "check": { "check": "element_in_frame", "element": "e.replay", "frame": "f.idempotency-keys" } },
    { "id": "a.in-frame-example", "dimension": "grouping", "severity": "minor", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The example sits in the frame.", "check": { "check": "element_in_frame", "element": "e.example", "frame": "f.idempotency-keys" } },
    { "id": "a.hierarchy", "dimension": "grouping", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The example hangs off the main idea and is not weighted above it.", "check": { "check": "hierarchy", "main": "e.definition", "supporting": ["e.example"], "why": "an example is supporting detail" } },
    { "id": "a.rel-example", "dimension": "relationships", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The example is linked to the mechanism it illustrates.", "check": { "check": "relationship_present", "relationship": "r.replay-example" } },
    { "id": "a.layout", "dimension": "visual", "severity": "critical", "method": "deterministic", "target": "render", "support": "implemented", "description": "No link runs through a card.", "check": { "check": "layout_no_fatal" } },
    { "id": "a.no-overlap", "dimension": "visual", "severity": "major", "method": "deterministic", "target": "render", "support": "implemented", "description": "Cards don't overlap.", "check": { "check": "cards_no_overlap" } },
    { "id": "a.inside-frames", "dimension": "visual", "severity": "major", "method": "deterministic", "target": "render", "support": "implemented", "description": "The frame is large enough for its cards.", "check": { "check": "children_inside_frames" } },
    { "id": "a.cites", "dimension": "traceability", "severity": "critical", "method": "deterministic", "target": "plan", "support": "future", "requires": ["ai.cites"], "description": "Every card cites its units: definition u1; replay u2, u6, u7, u8; example u3–u5; takeaway u9. No card cites a unit it doesn't represent." },
    { "id": "a.accounting", "dimension": "coverage", "severity": "critical", "method": "deterministic", "target": "plan", "support": "future", "requires": ["ai.unit-accounting", "ai.source-unit-ids"], "description": "All nine units are Represented; none is omitted (none is filler, duplicate, superseded or meta)." },
    { "id": "a.judge-distilled", "dimension": "element_selection", "severity": "major", "method": "model_judge", "target": "plan", "support": "implemented", "description": "Cards are distilled, not copied.", "judge": { "question": "Do the cards state the ideas in fresh words with titles that state the point, rather than reshuffled source sentences?", "pass": "Titles are statements ('A completed key gets its stored result back'); bodies are shorter than the sentences they cover; nothing is lost.", "fail": "Cards repeat the source sentences nearly word for word, or titles are bare topics ('Idempotency')." } },
    { "id": "a.judge-meaning", "dimension": "source_fidelity", "severity": "critical", "method": "human", "target": "plan", "support": "implemented", "description": "Each card keeps the meaning of what it covers.", "judge": { "question": "Compare each card with the units it represents. Is any qualifier, condition or limit weakened, widened or dropped?", "pass": "The window, the completed-request condition and the different-amount rejection all survive with their claim.", "fail": "Any card implies retries are safe without a time bound, or that any repeat of a key is replayed." } }
  ]
}
