{
  "datasetVersion": "1.0.0",
  "caseId": "kn-12-flag-rollout-update",
  "assertions": [
    { "id": "a.stages", "dimension": "coverage", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "v1 canvas: the three stages are on it.", "check": { "check": "element_present", "element": "e.stages" } },
    { "id": "a.canary", "dimension": "coverage", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "description": "v1 canvas: the canary window is on it.", "check": { "check": "element_present", "element": "e.canary" } },
    { "id": "a.advance-gate", "dimension": "coverage", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "description": "v1 canvas: the gate out of canary is on it.", "check": { "check": "element_present", "element": "e.advance-gate" } },
    { "id": "a.kill-switch", "dimension": "coverage", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "description": "v1 canvas: the kill-switch requirement is on it.", "check": { "check": "element_present", "element": "e.kill-switch" } },
    { "id": "a.ga-monitoring", "dimension": "coverage", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "v1 canvas: monitoring during the ramp-up is on it.", "check": { "check": "element_present", "element": "e.ga-monitoring" } },
    { "id": "a.cleanup", "dimension": "coverage", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "v1 canvas: the cleanup rule (v1 only) is on it.", "check": { "check": "element_present", "element": "e.cleanup" } },

    { "id": "a.canary-numbers-v1", "dimension": "source_fidelity", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "description": "v1 canvas: the canary card keeps 5% and the v1 minimum of 30 minutes, as a minimum.", "check": { "check": "text_present", "element": "e.canary", "all": [["5%"], ["30 minutes", "30 min"], ["at least", "minimum", "no less than"]], "why": "protected numbers of u12, u13; 'at least' makes it a minimum" } },
    { "id": "a.gate-condition", "dimension": "source_fidelity", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "regression": "condition_dropped", "description": "v1 canvas: the gate is a condition ('only when'), not a step that always happens.", "check": { "check": "text_present", "element": "e.advance-gate", "all": [["only when", "only if", "only after", "must pass"]], "why": "u16 is a condition" } },
    { "id": "a.kill-switch-bound", "dimension": "source_fidelity", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "description": "v1 canvas: the kill switch keeps its 1-minute bound.", "check": { "check": "text_present", "element": "e.kill-switch", "all": [["1 minute", "one minute", "60 seconds"]], "why": "protected number (u20)" } },
    { "id": "a.kill-switch-canary-condition", "dimension": "source_fidelity", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "regression": "condition_dropped", "description": "v1 canvas: the kill-switch card keeps the prerequisite: a flag without a tested kill switch cannot enter canary.", "check": { "check": "text_present", "element": "e.kill-switch", "all": [["cannot enter", "can't enter", "can not enter", "not enter canary", "never enter", "no canary without", "must not enter", "only enter", "needs a tested", "requires a tested", "need a tested", "require a tested", "prerequisite"]], "why": "u22 is a critical condition; 'tested in staging before canary' (u21) alone does not say canary is blocked without it" } },
    { "id": "a.no-v2-in-v1", "dimension": "source_fidelity", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "description": "v1 canvas: no v2-only content leaks into it (on-call approval in any word order, rollback rehearsal, 60 minutes).", "check": { "check": "text_absent", "pattern": "on-call[^.;]{0,30}(?:approv|sign)|(?:approv|sign-off)[^.;]{0,30}on-call|rehears|\\b60 min(?:ute)?s?\\b", "why": "these exist only in v2 (u44, u47, u61); on the v1 canvas they change the critical u13 / u16" } },

    { "id": "a.frame-rollout", "dimension": "grouping", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "description": "Stages and the canary gate have a frame.", "check": { "check": "frame_present", "frame": "f.rollout" } },
    { "id": "a.frame-safety", "dimension": "grouping", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "Safety nets have a frame.", "check": { "check": "frame_present", "frame": "f.safety" } },
    { "id": "a.frame-cleanup", "dimension": "grouping", "severity": "minor", "method": "deterministic", "target": "plan", "support": "implemented", "description": "Cleanup has its own frame on the v1 canvas.", "check": { "check": "frame_present", "frame": "f.cleanup" } },
    { "id": "a.frame-count", "dimension": "grouping", "severity": "minor", "method": "deterministic", "target": "plan", "support": "implemented", "description": "A few frames by meaning, not one per heading.", "check": { "check": "frame_count", "min": 2, "max": 5 } },
    { "id": "a.together-rollout", "dimension": "grouping", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "Stages, canary and gate share a frame.", "check": { "check": "together", "elements": ["e.stages", "e.canary", "e.advance-gate"], "why": "one sequence" } },
    { "id": "a.apart-cleanup", "dimension": "grouping", "severity": "minor", "method": "deterministic", "target": "plan", "support": "implemented", "description": "Cleanup is not mixed into the rollout sequence.", "check": { "check": "apart", "elements": ["e.cleanup", "e.canary"], "why": "cleanup is a separate phase after the rollout" } },
    { "id": "a.in-frame-kill-switch", "dimension": "grouping", "severity": "minor", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The kill switch sits with the safety nets.", "check": { "check": "element_in_frame", "element": "e.kill-switch", "frame": "f.safety" } },

    { "id": "a.rel-canary-gate", "dimension": "relationships", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The canary leads to the gate.", "check": { "check": "relationship_present", "relationship": "r.canary-to-gate" } },
    { "id": "a.rel-kill-switch", "dimension": "relationships", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "regression": "dependency_reversed", "description": "Canary depends on a tested kill switch, in that direction.", "check": { "check": "relationship_present", "relationship": "r.canary-needs-kill-switch" } },

    { "id": "a.layout", "dimension": "visual", "severity": "critical", "method": "deterministic", "target": "render", "support": "implemented", "description": "No fatal layout issue.", "check": { "check": "layout_no_fatal" } },
    { "id": "a.no-overlap", "dimension": "visual", "severity": "major", "method": "deterministic", "target": "render", "support": "implemented", "description": "Cards don't overlap.", "check": { "check": "cards_no_overlap" } },
    { "id": "a.inside-frames", "dimension": "visual", "severity": "major", "method": "deterministic", "target": "render", "support": "implemented", "description": "Frames hold their cards.", "check": { "check": "children_inside_frames" } },
    { "id": "a.crossings", "dimension": "visual", "severity": "major", "method": "deterministic", "target": "render", "support": "implemented", "description": "At most 1 link crossing (a regression guard; organisation-layout plan Q11).", "check": { "check": "layout_crossings_max", "max": 1 } },
    { "id": "a.reading-order", "dimension": "visual", "severity": "major", "method": "deterministic", "target": "render", "support": "implemented", "description": "Frames read in the plan's order (top to bottom, each row left to right): no pair out of order as the gate renders today (v1).", "check": { "check": "reading_order_max", "max": 0 } },
    { "id": "a.rendered-frames", "dimension": "visual", "severity": "major", "method": "deterministic", "target": "render", "support": "implemented", "description": "The frames are drawn as planned: 2–5 frames on the canvas (the layout view of a.frame-count).", "check": { "check": "rendered_frame_count", "min": 2, "max": 5 } },

    { "id": "a.rc-stages", "dimension": "coverage", "severity": "major", "method": "deterministic", "target": "reconcile", "support": "implemented", "requires": ["reconcile.section-level"], "description": "Update: the unchanged stages card stays unchanged (no needless regeneration).", "check": { "check": "reconcile_state", "item": "i.stages" } },
    { "id": "a.rc-canary", "dimension": "source_fidelity", "severity": "critical", "method": "deterministic", "target": "reconcile", "support": "implemented", "requires": ["reconcile.section-level"], "description": "Update: the canary card is updated and shows the new 60-minute minimum.", "check": { "check": "reconcile_state", "item": "i.canary" } },
    { "id": "a.rc-advance", "dimension": "source_fidelity", "severity": "critical", "method": "deterministic", "target": "reconcile", "support": "implemented", "requires": ["reconcile.section-level"], "regression": "condition_dropped", "description": "Update: the gate card gains on-call approval as a second condition.", "check": { "check": "reconcile_state", "item": "i.advance-gate" } },
    { "id": "a.rc-kill-switch", "dimension": "source_fidelity", "severity": "critical", "method": "deterministic", "target": "reconcile", "support": "implemented", "requires": ["reconcile.user-edit-conflict"], "regression": "user_edit_overwritten", "description": "Update: the user's edit to the kill-switch card survives (unchanged or a conflict, never update_clean).", "check": { "check": "reconcile_state", "item": "i.kill-switch" } },
    { "id": "a.rc-cleanup", "dimension": "source_fidelity", "severity": "critical", "method": "deterministic", "target": "reconcile", "support": "implemented", "requires": ["reconcile.section-level"], "regression": "invented_detail", "description": "Update: the removed cleanup rule is proposed for removal, not kept.", "check": { "check": "reconcile_state", "item": "i.cleanup" } },
    { "id": "a.rc-rehearsal", "dimension": "coverage", "severity": "major", "method": "deterministic", "target": "reconcile", "support": "implemented", "requires": ["reconcile.section-level"], "description": "Update: the new rollback rehearsal is added.", "check": { "check": "reconcile_state", "item": "i.rehearsal" } },
    { "id": "a.rc-monitoring-review", "dimension": "traceability", "severity": "major", "method": "deterministic", "target": "reconcile", "support": "future", "requires": ["reconcile.card-level", "ai.source-unit-ids"], "description": "Update: the monitoring card, whose sentence was split in two, goes to Needs review ('source changed') instead of being rewritten or silently kept.", "check": { "check": "reconcile_state", "item": "i.ga-monitoring" } },
    { "id": "a.rc-card-level", "dimension": "coverage", "severity": "major", "method": "deterministic", "target": "reconcile", "support": "future", "requires": ["reconcile.card-level"], "description": "Update: only cards whose cited units changed are resent (canary, gate); within the Advancing section the unchanged definition of the metrics check is not regenerated; the stages and kill-switch cards cost no model call." },

    { "id": "a.cites", "dimension": "traceability", "severity": "critical", "method": "deterministic", "target": "plan", "support": "future", "requires": ["ai.cites"], "description": "v1 cards cite v1 units (stages u6–u11, canary u12–u15, gate u16–u19, kill switch u20–u24, monitoring u25–u27, cleanup u28–u31); after the update the same cards cite the v2 units of the same idea, and the rehearsal card cites u61–u63 only." },
    { "id": "a.accounting", "dimension": "coverage", "severity": "critical", "method": "deterministic", "target": "plan", "support": "future", "requires": ["ai.unit-accounting", "ai.source-unit-ids"], "description": "v1: every unit is Represented except u1–u4 (meta) and u5 (filler)." },

    { "id": "a.judge-minimal-regen", "dimension": "coverage", "severity": "major", "method": "model_judge", "target": "reconcile", "support": "implemented", "description": "The update changes only what changed.", "judge": { "question": "Compare the proposed update with the v1 → v2 diff. Does it change exactly the canary number, the gate's second condition, the new rehearsal and the removed cleanup, and leave every other card's wording alone?", "pass": "Stages and kill-switch cards are untouched; canary shows 60 minutes; the gate requires the metrics check and on-call approval; rehearsal is added; cleanup is proposed for removal; the user's runbook note is still there.", "fail": "Unchanged cards are reworded, a removed rule stays, the gate keeps only one condition, the old 30 minutes survives, or the user's note disappears." } },
    { "id": "a.judge-user-edit", "dimension": "source_fidelity", "severity": "critical", "method": "human", "target": "reconcile", "support": "implemented", "description": "The user's edit is respected.", "judge": { "question": "After the update, is the user's runbook note on the kill-switch card exactly as they wrote it, and was the user asked (conflict) rather than overruled if the card changed?", "pass": "The note 'Runbook RB-12 …' is intact; the card is unchanged or shown as a conflict with Keep mine.", "fail": "The card was regenerated from the source wording and the note is gone or altered." } }
  ]
}
