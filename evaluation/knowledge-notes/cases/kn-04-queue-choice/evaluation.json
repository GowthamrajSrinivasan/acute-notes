{
  "datasetVersion": "1.0.0",
  "caseId": "kn-04-queue-choice",
  "assertions": [
    { "id": "a.context", "dimension": "coverage", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The problem (jobs lost on deploys and crashes) is on the canvas.", "check": { "check": "element_present", "element": "e.context" } },
    { "id": "a.cost-table", "dimension": "element_selection", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The cost comparison is a table, not prose or three cards.", "check": { "check": "element_present", "element": "e.cost-table" } },
    { "id": "a.cost-figures", "dimension": "source_fidelity", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The table keeps the three monthly costs exactly.", "check": { "check": "text_present", "element": "e.cost-table", "all": [["$310"], ["$540"], ["$0 extra", "$0"]], "why": "protected cost figures (u11–u13)" } },
    { "id": "a.effort-figures", "dimension": "source_fidelity", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The table keeps the three effort figures.", "check": { "check": "text_present", "element": "e.cost-table", "all": [["2 hours", "2 h"], ["12 hours", "12 h"], ["4 hours", "4 h"]], "why": "protected effort figures (u11–u13)" } },
    { "id": "a.cost-growth-with-table", "dimension": "source_fidelity", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "regression": "condition_dropped", "description": "The managed queue's volume assumption ($900 at three times the volume) sits on the table.", "check": { "check": "text_present", "element": "e.cost-table", "all": [["$900", "900"]], "why": "the $310 holds only at today's volume (u14, u15)" } },
    { "id": "a.estimate-with-table", "dimension": "source_fidelity", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "regression": "condition_dropped", "description": "The broker's 12 hours is marked as an estimate on the table.", "check": { "check": "text_present", "element": "e.cost-table", "all": [["estimate", "estimated", "unmeasured", "guess"]], "why": "no one has run the broker; the effort is not measured (u28)" } },
    { "id": "a.options-in-table", "dimension": "coverage", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "description": "All three options are named in the comparison.", "check": { "check": "text_present", "element": "e.cost-table", "all": [["managed"], ["broker"], ["job table", "jobs table", "database"]], "why": "the comparison covers all three options (u6–u10)" } },
    { "id": "a.tradeoff-a", "dimension": "coverage", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The managed queue's trade-off is on the canvas.", "check": { "check": "element_present", "element": "e.tradeoff-a" } },
    { "id": "a.tradeoff-b", "dimension": "coverage", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The broker's trade-off is on the canvas.", "check": { "check": "element_present", "element": "e.tradeoff-b" } },
    { "id": "a.tradeoff-c", "dimension": "coverage", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The job table's trade-off is on the canvas.", "check": { "check": "element_present", "element": "e.tradeoff-c" } },
    { "id": "a.idempotent-with-a", "dimension": "source_fidelity", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "regression": "condition_dropped", "description": "The idempotent-handler condition stays on the managed queue's card.", "check": { "check": "text_present", "element": "e.tradeoff-a", "all": [["idempotent", "idempotency"]], "why": "at-least-once delivery is only safe with idempotent handlers (u25)" } },
    { "id": "a.reporting-exception-with-c", "dimension": "source_fidelity", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "regression": "critical_exception_omitted", "description": "The reporting-service exception stays on the job table's card.", "check": { "check": "text_present", "element": "e.tradeoff-c", "all": [["reporting service", "reporting"]], "why": "the transactional guarantee excludes the reporting service's jobs (u31)" } },
    { "id": "a.must-haves", "dimension": "coverage", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "description": "Both must-haves are on the canvas with the 1,800 figure.", "check": { "check": "element_present", "element": "e.must-haves" } },
    { "id": "a.weights", "dimension": "source_fidelity", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "All four weights are kept exactly.", "check": { "check": "text_present", "element": "e.weights", "all": [["40%"], ["30%"], ["20%"], ["10%"]], "why": "protected weights (u20–u23)" } },
    { "id": "a.load-test", "dimension": "source_fidelity", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The load test's figures are exact.", "check": { "check": "text_present", "element": "e.load-test", "all": [["1200"], ["18 ms", "18ms"], ["2000"], ["85%"], ["240 ms", "240ms"]], "why": "protected measurements (u34, u35)" } },
    { "id": "a.load-test-limits", "dimension": "source_fidelity", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "regression": "condition_dropped", "description": "The load test card says 1,800 was not tested and staging was a quarter of production size.", "check": { "check": "text_present", "element": "e.load-test", "all": [["not tested", "untested", "wasn't tested", "not measured"], ["quarter", "smaller than production", "1/4"]], "why": "the evidence doesn't cover the required load (u36)" } },
    { "id": "a.untested", "dimension": "coverage", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The canvas says the managed queue and broker were not tested.", "check": { "check": "element_present", "element": "e.untested" } },
    { "id": "a.deferred", "dimension": "coverage", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The deferral and what it waits for are on the canvas.", "check": { "check": "element_present", "element": "e.deferred" } },
    { "id": "a.open-requirements", "dimension": "coverage", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "Each option's open requirement is listed with the deferral.", "check": { "check": "text_present", "element": "e.deferred", "all": [["idempotent"], ["owner"], ["load test", "load-test"]], "why": "what each option would require (u42–u44)" } },
    { "id": "a.next-step", "dimension": "element_selection", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The next step is a checklist item with its owner.", "check": { "check": "element_present", "element": "e.next-step" } },
    { "id": "a.no-recommendation", "dimension": "source_fidelity", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "regression": "unsupported_recommendation", "description": "Nothing names a winner the note doesn't name.", "check": { "check": "text_absent", "pattern": "\\b(we (should|will|would|recommend) (choose|pick|use|adopt|go with|option)|we recommend|(?<!not )recommended (option|choice)|the best (option|choice)|the clear winner|is the (right|best|obvious) (choice|option))\\b", "why": "the note explicitly makes no recommendation (u39, u40)" } },
    { "id": "a.no-unmeasured-pass", "dimension": "source_fidelity", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "regression": "invented_detail", "description": "Nothing claims the job table handles 1,800 jobs a minute.", "check": { "check": "text_absent", "pattern": "\\b(handles|handled|sustains|sustained|supports|passed|passes|meets|met) (the )?1800\\b", "why": "1,800 a minute was never tested (u36)" } },
    { "id": "a.no-exactly-once", "dimension": "source_fidelity", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "regression": "possibility_to_guarantee", "description": "The managed queue isn't described as exactly-once.", "check": { "check": "text_absent", "pattern": "(?<!not )exactly[- ]once", "why": "the managed queue delivers at least once (u25)" } },
    { "id": "a.frame-options", "dimension": "grouping", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The options are compared in their own frame.", "check": { "check": "frame_present", "frame": "f.options" } },
    { "id": "a.frame-tradeoffs", "dimension": "grouping", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "Trade-offs have a frame.", "check": { "check": "frame_present", "frame": "f.tradeoffs" } },
    { "id": "a.frame-criteria", "dimension": "grouping", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "Criteria have a frame.", "check": { "check": "frame_present", "frame": "f.criteria" } },
    { "id": "a.frame-evidence", "dimension": "grouping", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "Evidence has a frame.", "check": { "check": "frame_present", "frame": "f.evidence" } },
    { "id": "a.frame-status", "dimension": "grouping", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The decision status has a frame.", "check": { "check": "frame_present", "frame": "f.status" } },
    { "id": "a.frame-count", "dimension": "grouping", "severity": "minor", "method": "deterministic", "target": "plan", "support": "implemented", "description": "A handful of meaningful frames, not one per paragraph.", "check": { "check": "frame_count", "min": 4, "max": 8 } },
    { "id": "a.table-in-options", "dimension": "grouping", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The cost table sits in the comparison frame.", "check": { "check": "element_in_frame", "element": "e.cost-table", "frame": "f.options" } },
    { "id": "a.tradeoffs-together", "dimension": "grouping", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The three trade-offs sit side by side in one frame.", "check": { "check": "together", "elements": ["e.tradeoff-a", "e.tradeoff-b", "e.tradeoff-c"], "why": "trade-offs are compared like with like" } },
    { "id": "a.tradeoffs-in-frame", "dimension": "grouping", "severity": "minor", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The trade-offs sit in the trade-offs frame.", "check": { "check": "element_in_frame", "element": "e.tradeoff-a", "frame": "f.tradeoffs" } },
    { "id": "a.criteria-together", "dimension": "grouping", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "Must-haves and weights sit together.", "check": { "check": "together", "elements": ["e.must-haves", "e.weights"], "why": "both are selection criteria" } },
    { "id": "a.criteria-in-frame", "dimension": "grouping", "severity": "minor", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The must-haves sit in the criteria frame.", "check": { "check": "element_in_frame", "element": "e.must-haves", "frame": "f.criteria" } },
    { "id": "a.evidence-in-frame", "dimension": "grouping", "severity": "minor", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The load test sits in the evidence frame.", "check": { "check": "element_in_frame", "element": "e.load-test", "frame": "f.evidence" } },
    { "id": "a.untested-in-frame", "dimension": "grouping", "severity": "minor", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The evidence gap sits with the evidence.", "check": { "check": "element_in_frame", "element": "e.untested", "frame": "f.evidence" } },
    { "id": "a.status-in-frame", "dimension": "grouping", "severity": "minor", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The deferral sits in the decision-status frame.", "check": { "check": "element_in_frame", "element": "e.deferred", "frame": "f.status" } },
    { "id": "a.next-step-in-frame", "dimension": "grouping", "severity": "minor", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The next step sits with the decision status.", "check": { "check": "element_in_frame", "element": "e.next-step", "frame": "f.status" } },
    { "id": "a.criteria-apart-options", "dimension": "grouping", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "Criteria and the options table are in different frames.", "check": { "check": "apart", "elements": ["e.must-haves", "e.cost-table"], "why": "criteria judge the options; they are not part of the comparison" } },
    { "id": "a.criteria-apart-c", "dimension": "grouping", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The must-haves are not merged into the job table's card or frame.", "check": { "check": "apart", "elements": ["e.must-haves", "e.tradeoff-c"], "why": "a criterion is not one option's benefit" } },
    { "id": "a.status-apart-c", "dimension": "grouping", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The decision status is not placed inside one option's group.", "check": { "check": "apart", "elements": ["e.deferred", "e.tradeoff-c"], "why": "placing it there reads as that option's verdict" } },
    { "id": "a.hierarchy-evidence", "dimension": "grouping", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The load test hangs off the job table's trade-off and is not weighted above it.", "check": { "check": "hierarchy", "main": "e.tradeoff-c", "supporting": ["e.load-test"], "why": "evidence supports a claim" } },
    { "id": "a.rel-evidence", "dimension": "relationships", "severity": "critical", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The load test is linked to the job table's trade-off.", "check": { "check": "relationship_present", "relationship": "r.loadtest-supports-c" } },
    { "id": "a.rel-deferred-evidence", "dimension": "relationships", "severity": "major", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The deferral is linked to the evidence it waits on.", "check": { "check": "relationship_present", "relationship": "r.deferred-from-loadtest" } },
    { "id": "a.rel-deferred-criteria", "dimension": "relationships", "severity": "minor", "method": "deterministic", "target": "plan", "support": "implemented", "description": "The deferral is linked to the throughput must-have (inferred; optional).", "check": { "check": "relationship_present", "relationship": "r.deferred-from-musthaves" } },
    { "id": "a.layout", "dimension": "visual", "severity": "critical", "method": "deterministic", "target": "render", "support": "implemented", "description": "No link runs through a card.", "check": { "check": "layout_no_fatal" } },
    { "id": "a.no-overlap", "dimension": "visual", "severity": "major", "method": "deterministic", "target": "render", "support": "implemented", "description": "Cards don't overlap.", "check": { "check": "cards_no_overlap" } },
    { "id": "a.inside-frames", "dimension": "visual", "severity": "major", "method": "deterministic", "target": "render", "support": "implemented", "description": "Frames are large enough for their cards.", "check": { "check": "children_inside_frames" } },
    { "id": "a.cites", "dimension": "traceability", "severity": "critical", "method": "deterministic", "target": "plan", "support": "future", "requires": ["ai.cites"], "description": "Every card cites its units: table u6–u15 and u28; trade-offs A u24–u26, B u27 and u29, C u30–u32; criteria u16–u23; evidence u33–u38; status u39–u44; next step u45." },
    { "id": "a.accounting", "dimension": "coverage", "severity": "critical", "method": "deterministic", "target": "plan", "support": "future", "requires": ["ai.unit-accounting", "ai.source-unit-ids"], "description": "All units except u1 (meta) and u46 (filler) are Represented; every critical unit is Represented." },
    { "id": "a.judge-balanced", "dimension": "source_fidelity", "severity": "critical", "method": "model_judge", "target": "plan", "support": "implemented", "regression": "unsupported_recommendation", "description": "The canvas stays neutral between the options.", "judge": { "question": "Does any title, takeaway, ordering or emphasis imply that one option is preferred, recommended or chosen, when the source defers the decision?", "pass": "Options are presented with equal weight; the decision frame says no option is chosen and what the decision waits for.", "fail": "A takeaway like 'the job table is the pragmatic choice', a highlighted row, or a title that names a winner." } },
    { "id": "a.judge-conditions", "dimension": "source_fidelity", "severity": "critical", "method": "human", "target": "plan", "support": "implemented", "description": "Each option's conditions survive.", "judge": { "question": "Compare each trade-off card and the table with the source. Is any condition weakened or dropped: idempotent handlers, the reporting-service exception, the volume assumption, the broker estimate, the untested 1,800 load?", "pass": "All five conditions are on the card or row they qualify.", "fail": "Any option reads as having no catch, or the load test reads as proving the job table passes." } }
  ]
}
