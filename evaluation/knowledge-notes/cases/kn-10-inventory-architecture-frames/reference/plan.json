      "content": {
        "label": "Client & presentation",
        "arrangement": "stack",
        "takeaway": "Screens for staff; no stock logic of their own",
        "diagram": "architecture"
      }
    },
    {
      "id": "n-ui",
      "type": "shape",
      "parent": "g-ui",
      "importance": "high",
      "content": {
        "shape": "rectangle",
        "label": "Admin web UI",
        "kind": "frontend",
        "sublabel": "web/admin/",
        "details": [
          "Stock lookup, manual holds, failed-import review",
          "Calls only the REST API; never the database"
        ]
      }
    },
    {
      "id": "g-api",
      "type": "group",
      "content": {
        "label": "API & orchestration",
        "arrangement": "stack",
        "takeaway": "Validates, routes and coordinates; handlers hold no business rules",
        "diagram": "architecture"
      }
    },
    {
      "id": "n-http",
      "type": "shape",
      "parent": "g-api",
      "importance": "high",
      "content": {
        "shape": "rectangle",
        "label": "HTTP handlers",
        "kind": "backend",
        "sublabel": "src/api/routes.ts",
        "details": [
          "Only entry point for requests",
          "Validates the body, attaches a correlation ID"
        ]
      }
    },
    {
      "id": "n-orch",
      "type": "shape",
      "parent": "g-api",
      "importance": "high",
      "content": {
        "shape": "rectangle",
        "label": "Reservation orchestrator",
        "kind": "backend",
        "sublabel": "src/orders/reserve.ts",
        "details": [
          "Handles POST /reservations; publishes StockReserved once stock and price both succeed",
          "Rejects the whole order if stock is short; never makes a partial reservation"
        ]
      }
    },
    {
      "id": "g-domain",
      "type": "group",
      "content": {
        "label": "Domain services",
        "arrangement": "stack",
        "takeaway": "Owns stock and prices; never depends on the HTTP layer",
        "diagram": "architecture"
      }
    },
    {
      "id": "n-ledger",
      "type": "shape",
      "parent": "g-domain",
      "importance": "high",
      "content": {
        "shape": "rectangle",
        "label": "Stock ledger",
        "kind": "backend",
        "sublabel": "src/ledger/ledger.ts",
        "details": [
          "Owns stock levels: append-only entries (reserve, release, restock)",
          "Only module that writes stock",
          "Releases holds not confirmed within 15 minutes"
        ]
      }
    },
    {
      "id": "n-pricing",
      "type": "shape",
      "parent": "g-domain",
      "importance": "high",
      "content": {
        "shape": "rectangle",
        "label": "Pricing rules",
        "kind": "backend",
        "sublabel": "src/pricing/rules.ts",
        "details": [
          "Prices from supplier price lists and active discounts",
          "Price lists cached 300 seconds",
          "Never changes stock"
        ]
      }
    },
    {
      "id": "g-persistence",
      "type": "group",
      "content": {
        "label": "Persistence & external systems",
        "arrangement": "stack",
        "takeaway": "Postgres is the source of truth; the supplier API is outside our control",
        "diagram": "architecture"
      }
    },
    {
      "id": "n-postgres",
      "type": "shape",
      "parent": "g-persistence",
      "importance": "high",
      "content": {
        "shape": "cylinder",
        "label": "Postgres",
        "kind": "database",
        "sublabel": "Stock levels and entries; source of truth",
        "details": [
          "Migrations in db/migrations/, run on every deploy"
        ]
      }
    },
    {
      "id": "n-redis",
      "type": "shape",
