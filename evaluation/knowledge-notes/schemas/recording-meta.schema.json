{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "datasetVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "runId": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9-]+$"
    },
    "recordedAt": {
      "type": "string",
      "minLength": 1
    },
    "approvedBy": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "pipeline": {
      "type": "object",
      "properties": {
        "noteModel": {
          "type": "string",
          "enum": [
            "preserve",
            "distil"
          ]
        },
        "promptVersion": {
          "type": "string",
          "minLength": 1
        },
        "appVersion": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "noteModel",
        "promptVersion",
        "appVersion"
      ]
    },
    "gate": {
      "type": "boolean"
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "caseId": {
            "type": "string",
            "pattern": "^kn-\\d{2}-[a-z0-9-]+$"
          },
          "plan": {
            "type": "string",
            "minLength": 1
          },
          "lens": {
            "type": "string",
            "minLength": 1
          },
          "reconcile": {
            "type": "string",
            "minLength": 1
          },
          "replies": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "caseId"
        ]
      }
    }
  },
  "required": [
    "datasetVersion",
    "runId",
    "recordedAt",
    "approvedBy",
    "provider",
    "model",
    "pipeline",
    "gate",
    "cases"
  ]
}
