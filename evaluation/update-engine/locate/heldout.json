      "id": "h1",
      "title": "Kessler Lab - Protein Folding Group",
      "sections": [
        { "id": "h1s1", "name": "Experiments", "cards": [
          { "id": "h1c01", "kind": "text", "text": "Current focus is the thermal stability of mutant lysozyme variants. Runs use 96-well plates at 25 °C. Priya Nair leads the analysis." },
          { "id": "h1c02", "kind": "list", "items": ["Batch A: wild-type control, 12 replicates", "Batch B: L99A mutant, 8 replicates", "Batch C: T4 double mutant, pending purification", "Buffer: 50 mM phosphate, pH 7.0"] },
          { "id": "h1c03", "kind": "todo", "items": ["Re-run Batch B melt curves", "Upload raw spectra to shared drive", "Write up methods for Batch A"] }
        ] },
        { "id": "h1s2", "name": "Equipment booking", "cards": [
          { "id": "h1c04", "kind": "table", "header": ["Instrument", "Room", "Booked by", "Slot"], "rows": [
            ["Circular dichroism spectrometer", "B214", "Priya", "Mon 9-12"],
            ["Plate reader", "B210", "Tom", "Tue 14-17"],
            ["Ultracentrifuge", "B118", "Ana", "Thu 10-13"]
          ] },
          { "id": "h1c05", "kind": "text", "text": "Bookings go through the LabCal calendar at least 48 hours ahead. Cancellations must be posted by noon the day before." },
          { "id": "h1c06", "kind": "list", "items": ["Plate reader lamp replaced in March", "Centrifuge rotor rated to 60,000 rpm", "CD spectrometer needs nitrogen purge for 20 min"] }
        ] },
        { "id": "h1s3", "name": "Grants and deadlines", "cards": [
          { "id": "h1c07", "kind": "table", "header": ["Grant", "Funder", "Deadline", "Owner"], "rows": [
            ["Protein dynamics R01 renewal", "NIH", "Feb 5", "Dr. Kessler"],
            ["Equipment supplement", "NSF MRI", "Jan 20", "Tom Becker"],
            ["Student fellowship", "Wellcome", "Mar 12", "Ana Ruiz"]
          ] },
          { "id": "h1c08", "kind": "todo", "items": ["Draft specific aims for R01", "Collect letters of support", "Get budget sign-off from department"] },
          { "id": "h1c09", "kind": "text", "text": "All grant budgets need approval from the research office 10 working days before submission." }
        ] },
        { "id": "h1s4", "name": "Lab safety", "cards": [
          { "id": "h1c10", "kind": "list", "items": ["Lab coats and goggles at all times", "No food or drink past the yellow line", "Chemical waste goes in the blue carboys", "Eyewash station checked weekly"] },
          { "id": "h1c11", "kind": "todo", "items": ["Renew biosafety training for new students", "Restock spill kit in B210"] },
          { "id": "h1c12", "kind": "text", "text": "Safety officer is Dr. Malik, extension 4471. Report any spill within one hour." }
        ] }
      ]
