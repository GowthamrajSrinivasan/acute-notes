  "canvases": [
    { "id": "d1", "title": "Lumen Fitness app v4.2 release",
      "sections": [
        { "id": "d1s1", "name": "Release plan", "cards": [
          { "id": "d1c01", "kind": "text", "text": "Version 4.2 ships to iOS and Android on 3 March. Code freeze is 20 February. Release manager is Priya Nair." },
          { "id": "d1c02", "kind": "list", "items": ["Workout streaks widget", "Apple Health sync fix", "Dark mode for settings", "Offline route maps"] },
          { "id": "d1c03", "kind": "table", "header": ["Platform", "Build", "Status"], "rows": [["iOS", "4.2.0 (311)", "In QA"], ["Android", "4.2.0 (5120)", "In QA"], ["Wear OS", "1.8.1 (77)", "Blocked"]] }
        ] },
        { "id": "d1s2", "name": "Store review", "cards": [
          { "id": "d1c04", "kind": "text", "text": "App Store review usually takes 24-48 hours. Google Play rollout starts at 10% staged." },
          { "id": "d1c05", "kind": "todo", "items": ["Upload new screenshots for 6.7-inch iPhone", "Update privacy nutrition label", "Write release notes in 5 languages", "Submit for review by 26 February"] },
          { "id": "d1c06", "kind": "list", "items": ["Guideline 2.1 crash on login (v4.0)", "Missing account deletion link (v4.1)"] }
        ] },
        { "id": "d1s3", "name": "Crash reporting", "cards": [
          { "id": "d1c07", "kind": "text", "text": "Crashlytics is the crash tool for both platforms. Crash-free users target is 99.5%." },
          { "id": "d1c08", "kind": "table", "header": ["Crash", "Users affected", "Owner"], "rows": [["NullPointer in RouteMapView", "412", "Tomás"], ["OOM on photo upload", "188", "Aiko"], ["Deadlock in sync worker", "95", "Priya"]] },
          { "id": "d1c09", "kind": "todo", "items": ["Add dSYM upload to CI", "Set Slack alert for new fatal issues", "Tag crashes by build number"] }
        ] },
        { "id": "d1s4", "name": "Beta testers", "cards": [
          { "id": "d1c10", "kind": "list", "items": ["TestFlight external group: 250 testers", "Play internal track: 40 staff", "Firebase App Distribution for QA vendor"] },
          { "id": "d1c11", "kind": "text", "text": "Beta feedback goes to the #beta-lumen Slack channel. Testers get a free premium month." },
          { "id": "d1c12", "kind": "list", "items": ["Bigger font on summary screen", "Export workouts to CSV", "Haptic cue at lap end"] }
        ] }
      ] },
    { "id": "d2", "title": "Harborline support operations",
      "sections": [
        { "id": "d2s1", "name": "Queues and routing", "cards": [
          { "id": "d2c01", "kind": "text", "text": "Zendesk is our help desk. Tickets route by product tag into three queues. Weekend coverage is handled from Manila." },
          { "id": "d2c02", "kind": "table", "header": ["Queue", "Agents", "Hours"], "rows": [["Login and accounts", "6", "24/7"], ["Scheduling bugs", "9", "Mon-Fri 7-19 UTC"], ["Integrations", "4", "Mon-Fri 9-17 UTC"]] },
          { "id": "d2c03", "kind": "list", "items": ["VIP customers skip to the front", "Spanish tickets go to Lucía's pod", "Tickets with 'data loss' keyword flag the lead", "Unassigned after 2 hours go to triage"] }
        ] },
        { "id": "d2s2", "name": "SLAs", "cards": [
          { "id": "d2c04", "kind": "table", "header": ["Tier", "First response", "Resolution"], "rows": [["Enterprise", "1 hour", "1 day"], ["Pro", "4 hours", "3 days"], ["Free", "24 hours", "No target"]] },
          { "id": "d2c05", "kind": "text", "text": "SLA clock pauses while a ticket is pending on the customer. Breaches are reviewed every Monday by Dmitri." },
          { "id": "d2c06", "kind": "todo", "items": ["Add SLA breach widget to the team dashboard", "Agree weekend SLA for Enterprise", "Document pause rules in the wiki"] }
        ] },
        { "id": "d2s3", "name": "Macros", "cards": [
          { "id": "d2c07", "kind": "list", "items": ["Password reset steps", "Calendar sync troubleshooting", "Feature request acknowledgement", "Closing after 3 days no reply"] },
          { "id": "d2c08", "kind": "todo", "items": ["Retire 40 unused macros", "Translate top 10 macros into German", "Add screenshots to sync macro"] },
          { "id": "d2c09", "kind": "text", "text": "Macros are owned by the knowledge team. Any agent can propose one in #macro-requests." }
        ] },
        { "id": "d2s4", "name": "Escalation", "cards": [
          { "id": "d2c10", "kind": "list", "items": ["Tier 1 agent", "Tier 2 specialist", "Product engineering via Jira SUP project", "Head of Support Maya Okafor"] },
          { "id": "d2c11", "kind": "text", "text": "Escalate when a fix needs code changes or affects more than 20 accounts. Include repro steps and the account ID." }
        ] },
        { "id": "d2s5", "name": "Satisfaction surveys", "cards": [
          { "id": "d2c12", "kind": "table", "header": ["Month", "CSAT", "Responses"], "rows": [["July", "91%", "640"], ["August", "88%", "702"], ["September", "90%", "655"]] },
          { "id": "d2c13", "kind": "list", "items": ["Sent 24 hours after ticket is solved", "Two questions plus a free-text box", "Delighted tool for NPS twice a year"] }
        ] }
      ] },
    { "id": "d3", "title": "Fernbrook trust and compliance programme",
      "sections": [
        { "id": "d3s1", "name": "Audits", "cards": [
          { "id": "d3c01", "kind": "text", "text": "SOC 2 Type II audit window runs 1 January to 30 June. Auditor is Keller & Shaw LLP." },
          { "id": "d3c02", "kind": "table", "header": ["Audit", "Month", "Lead"], "rows": [["SOC 2 fieldwork", "July", "Hana Ito"], ["ISO 27001 surveillance", "September", "Marco Bell"], ["PCI self-assessment", "November", "Hana Ito"]] },
          { "id": "d3c03", "kind": "todo", "items": ["Collect evidence for change management", "Export laptop encryption report", "Book auditor kickoff call"] }
        ] },
        { "id": "d3s2", "name": "Policies", "cards": [
          { "id": "d3c04", "kind": "list", "items": ["Acceptable use", "Data retention: 7 years for contracts", "Password and MFA", "Remote work and devices"] },
          { "id": "d3c05", "kind": "text", "text": "Policies are reviewed yearly and signed by every employee in Vanta. The CISO, Rachel Dunn, approves changes." },
          { "id": "d3c06", "kind": "todo", "items": ["Add AI tool usage to acceptable use", "Merge two backup policies", "Get legal sign-off on retention changes"] }
        ] },
        { "id": "d3s3", "name": "Access reviews", "cards": [
          { "id": "d3c07", "kind": "text", "text": "Access reviews run quarterly for production, GitHub and Google Workspace. Managers have 10 working days to respond." },
          { "id": "d3c08", "kind": "table", "header": ["System", "Accounts reviewed", "Removed"], "rows": [["AWS production", "84", "6"], ["GitHub", "142", "11"], ["Google Workspace", "310", "19"]] },
          { "id": "d3c09", "kind": "list", "items": ["Leavers removed within 24 hours", "Admin roles need two approvers", "Shared accounts are banned"] }
        ] },
        { "id": "d3s4", "name": "Vendor assessments", "cards": [
          { "id": "d3c10", "kind": "table", "header": ["Vendor", "Tier", "Next review"], "rows": [["Salesforce", "High", "March 2027"], ["Intercom", "Medium", "June 2027"], ["Calendly", "Low", "December 2027"]] },
          { "id": "d3c11", "kind": "list", "items": ["Current SOC 2 report or ISO certificate", "Data processing agreement signed", "Sub-processor list", "Breach notification within 72 hours"] },
          { "id": "d3c12", "kind": "todo", "items": ["Re-assess Intercom after their acquisition", "Build intake form for new vendors"] }
        ] }
      ] },
    { "id": "d4", "title": "Pathway Planner 3 launch",
      "sections": [
        { "id": "d4s1", "name": "Positioning", "cards": [
          { "id": "d4c01", "kind": "text", "text": "Pathway Planner 3 is positioned as the planning tool for small agencies. Main rival is Asana." },
          { "id": "d4c02", "kind": "list", "items": ["Plan a client project in 10 minutes", "Built-in time tracking", "Free for teams under 5", "Works offline on iPad"] },
          { "id": "d4c03", "kind": "todo", "items": ["Test tagline with 8 agency owners", "Finalise competitor comparison page"] }
        ] },
        { "id": "d4s2", "name": "Channels", "cards": [
          { "id": "d4c04", "kind": "list", "items": ["Product Hunt on launch day", "Email to 42,000 trial users", "LinkedIn ads targeting agency founders", "Partner webinar with Webflow"] },
          { "id": "d4c05", "kind": "table", "header": ["Channel", "Owner", "Goal"], "rows": [["Email", "Sofia Reyes", "6% click rate"], ["Product Hunt", "Ben Adler", "Top 3 of the day"], ["LinkedIn ads", "Sofia Reyes", "900 sign-ups"]] },
          { "id": "d4c06", "kind": "text", "text": "Influencer posts are on hold until legal approves disclosure wording." }
        ] },
        { "id": "d4s3", "name": "Budget", "cards": [
          { "id": "d4c07", "kind": "table", "header": ["Line", "Amount", "Status"], "rows": [["Paid social", "$40,000", "Approved"], ["Launch video", "$18,000", "Approved"], ["Swag for webinar", "$3,500", "Pending"], ["Contingency", "$6,000", "Approved"]] },
          { "id": "d4c08", "kind": "text", "text": "Total launch budget is $67,500. Any spend over $2,000 needs Lena's sign-off." },
          { "id": "d4c09", "kind": "list", "items": ["Reuse 2024 video footage", "In-house design for ads", "Drop print brochure"] }
        ] },
        { "id": "d4s4", "name": "Timeline", "cards": [
          { "id": "d4c10", "kind": "list", "items": ["Messaging locked: 10 April", "Landing page live: 2 May", "Press embargo lifts: 13 May", "Launch day: 14 May"] },
          { "id": "d4c11", "kind": "todo", "items": ["Brief sales team on 3.0 pricing", "Record demo video", "Schedule social posts in Buffer", "Prepare launch-day status updates"] },
          { "id": "d4c12", "kind": "text", "text": "Retro meeting is planned for 28 May with all channel owners." }
        ] }
      ] },
    { "id": "d5", "title": "Kestrel cloud costs FY27",
      "sections": [
        { "id": "d5s1", "name": "Budgets", "cards": [
          { "id": "d5c01", "kind": "text", "text": "FY27 cloud budget is $1.8M across AWS and GCP. Engineering VP Omar Haddad owns it." },
          { "id": "d5c02", "kind": "table", "header": ["Team", "Monthly budget", "Actual Oct"], "rows": [["Search", "$42,000", "$45,300"], ["Mobile backend", "$28,000", "$26,100"], ["ML training", "$60,000", "$71,800"]] },
          { "id": "d5c03", "kind": "list", "items": ["Overspend above 10% needs a written plan", "Unused budget does not roll over", "New services get a 3-month grace period"] }
        ] },
        { "id": "d5s2", "name": "Reserved capacity", "cards": [
          { "id": "d5c04", "kind": "table", "header": ["Commitment", "Term", "Coverage"], "rows": [["EC2 Savings Plan", "3 years", "62%"], ["RDS reserved instances", "1 year", "80%"], ["GCP committed use", "1 year", "45%"]] },
          { "id": "d5c05", "kind": "todo", "items": ["Model a second Savings Plan for Graviton", "Sell unused RDS reservations on marketplace", "Review coverage every month"] },
          { "id": "d5c06", "kind": "text", "text": "Target coverage is 70% of steady compute. Purchases above $50k need Omar's approval." }
        ] },
        { "id": "d5s3", "name": "Tagging", "cards": [
          { "id": "d5c07", "kind": "list", "items": ["team", "env (prod, staging, dev)", "cost-center", "owner email"] },
          { "id": "d5c08", "kind": "text", "text": "Untagged spend was 14% in October. Goal is under 5% by end of Q1." },
          { "id": "d5c09", "kind": "todo", "items": ["Enforce tags with AWS SCP", "Backfill tags on legacy S3 buckets", "Add tag check to Terraform CI"] }
        ] },
        { "id": "d5s4", "name": "Cost alerts", "cards": [
          { "id": "d5c10", "kind": "list", "items": ["Daily spend 25% above 7-day average", "Any single resource over $500/day", "Forecast to exceed monthly budget"] },
          { "id": "d5c11", "kind": "text", "text": "Alerts post to #cloud-costs and email the team lead. Anomaly detection uses AWS Cost Anomaly Detection." },
          { "id": "d5c12", "kind": "todo", "items": ["Mute alerts for planned load tests", "Add GCP budget alerts"] }
        ] }
      ] }
  ],
