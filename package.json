{
  "name": "acute-notes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "patch-package && node scripts/copy-excalidraw-assets.mjs",
    "predev": "node scripts/copy-excalidraw-assets.mjs",
    "prebuild": "node scripts/copy-excalidraw-assets.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:golden": "vitest run --config vitest.evaluation.config.ts",
    "test:e2e": "playwright test --project=local",
    "test:desktop-storage": "playwright test --config playwright.desktop.config.ts",
    "test:e2e:ai": "node scripts/e2e-ai.mjs",
    "desktop:build": "cross-env ACUTE_DESKTOP=1 NEXT_PUBLIC_AI_FEATURE=on NEXT_PUBLIC_MCP_FEATURE=on next build --webpack && node scripts/prepare-desktop.mjs",
    "desktop:pack": "npm run desktop:build && electron-builder --dir",
    "desktop:dist": "npm run desktop:build && electron-builder",
    "desktop:icons": "node scripts/make-icons.mjs",
    "desktop:run": "electron ."
  },
  "dependencies": {
    "@blocknote/core": "^0.55.0",
    "@blocknote/mantine": "^0.55.0",
    "@blocknote/react": "^0.55.0",
    "@excalidraw/excalidraw": "^0.18.1",
    "@github/copilot-sdk": "^1.0.14",
    "@mantine/core": "^8.3.18",
    "@mantine/hooks": "^8.3.18",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "html-to-image": "^1.11.13",
    "idb": "^8.0.3",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mermaid": "^12.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^10.1.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.5",
    "patch-package": "^8.0.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  },
  "main": "electron/main.cjs",
  "description": "Acute Notes desktop app",
  "author": "Acute Notes"
}
