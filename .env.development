# Loaded by `next dev`. Build-level switches (see src/config/features.ts).
# .env.local or the shell environment overrides this.
NEXT_PUBLIC_AI_FEATURE=on
# Topic merge (G2.2): Visualize offers "Merge into existing notes". Off unless "on".
NEXT_PUBLIC_TOPIC_MERGE=on
# OpenUI Notes view (openui-integration-plan Phases 2–3): a reading view over the canvas's cards. Off unless "on".
NEXT_PUBLIC_OPENUI_NOTES=on
# OpenUI-rendered canvas cards: adds "Cards" to the header's View toggle (development only; production stays off).
NEXT_PUBLIC_OPENUI_CANVAS=on
# MCP is independent of the AI flag. MCP_FEATURE is enforced by the server's routes; NEXT_PUBLIC_MCP_FEATURE only
# shows/hides the UI. MCP_OAUTH_FEATURE (plus MCP_PUBLIC_BASE_URL) switches the OAuth flow on separately.
MCP_FEATURE=on
NEXT_PUBLIC_MCP_FEATURE=on
MCP_OAUTH_FEATURE=off

# AI consistency check (Stage 4f pilot): OFF by default. CONSISTENCY_AI_CHECK is enforced by /api/ai/judge (404 unless
# exactly "on"); NEXT_PUBLIC_CONSISTENCY_AI_CHECK only shows the opt-in in the Consistency panel. Turn both on to pilot it.
CONSISTENCY_AI_CHECK=off
NEXT_PUBLIC_CONSISTENCY_AI_CHECK=off
