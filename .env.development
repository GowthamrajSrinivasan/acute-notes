# Loaded by `next dev`. Build-level switches (see src/config/features.ts).
# .env.local or the shell environment overrides this.
NEXT_PUBLIC_AI_FEATURE=on
# Topic merge (G2.2): Visualize offers "Merge into existing notes". Off unless "on".
NEXT_PUBLIC_TOPIC_MERGE=on
# MCP is independent of the AI flag. MCP_FEATURE is enforced by the server's routes; NEXT_PUBLIC_MCP_FEATURE only
# shows/hides the UI. MCP_OAUTH_FEATURE (plus MCP_PUBLIC_BASE_URL) switches the OAuth flow on separately.
MCP_FEATURE=on
NEXT_PUBLIC_MCP_FEATURE=on
MCP_OAUTH_FEATURE=off
