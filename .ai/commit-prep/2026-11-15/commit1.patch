index 0000000000000000000000000000000000000000..97f9935d9ab201bdc085e391e46f572746605ecb
--- /dev/null
+++ b/src/ai/openui/interactions.test.tsx
@@ -0,0 +1,206 @@
+// @vitest-environment happy-dom
+/**
+ * Phase 3 acceptance (`.ai/docs/openui-integration-plan.md`): "meaningful interaction without additional model calls for
+ * basic UI actions". Each card is rendered from OpenUI Lang through the real `Renderer`, clicked, and checked — no
+ * mocks of the runtime, no network.
+ */
+import { createParser, Renderer } from "@openuidev/react-lang";
+import { act, type ReactElement } from "react";
+import { createRoot, type Root } from "react-dom/client";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { NotesHostProvider, type NotesHost } from "./hostContext";
+import { acuteCardLibrary } from "./library";
+
+(globalThis as { IS_REACT_ACT_ENVIRONMENT?: boolean }).IS_REACT_ACT_ENVIRONMENT = true;
+
+let host: HTMLDivElement;
+let root: Root;
+beforeEach(() => {
+  host = document.createElement("div");
+  document.body.appendChild(host);
+  root = createRoot(host);
+});
+afterEach(() => {
+  act(() => root.unmount());
+  host.remove();
+});
+
+const render = (el: ReactElement) => act(() => root.render(el));
+const renderLang = (lang: string, notesHost: NotesHost = {}, onStateUpdate?: (s: Record<string, unknown>) => void) =>
+  render(
+    <NotesHostProvider value={notesHost}>
+      <Renderer response={lang} library={acuteCardLibrary} isStreaming={false} onStateUpdate={onStateUpdate} />
+    </NotesHostProvider>,
+  );
+const $ = (sel: string) => host.querySelector(sel) as HTMLElement | null;
+const $$ = (sel: string) => [...host.querySelectorAll(sel)] as HTMLElement[];
+const click = (el: Element | null | undefined) => {
+  expect(el).toBeTruthy();
+  act(() => el!.dispatchEvent(new MouseEvent("click", { bubbles: true })));
+};
+const parse = (lang: string) => createParser(acuteCardLibrary.toJSONSchema()).parse(lang);
+
+const DECISION = `
+root = DecisionCard("Which queue should orders use?", [a, b], "SQS FIFO", "Orders need strict per-customer ordering.", ["u3"])
+a = DecisionOption("SQS Standard", ["Cheap", "Unlimited throughput"], ["Best-effort ordering"])
+b = DecisionOption("SQS FIFO", ["Strict ordering per group"], ["300 msg/s per group"])
+`.trim();
+
+const TIMELINE = `
+root = Timeline("Rollout", [e1, e2])
+e1 = TimelineEvent("Mon", "Canary at 5%", "Error rate held at baseline.", "u2")
+e2 = TimelineEvent("Wed", "Full rollout")
+`.trim();
+
+const FLOW = `root = FlowDiagram("Blue-green deploy", ["Deploy green", "Smoke test", "Switch traffic"], ["New version beside the old.", "Checks against green only.", "Load balancer flips."])`;
+const QUIZ = `root = QuizCard("What does an idempotency key prevent?", ["Slow responses", "Duplicate charges", "Expired tokens"], 1, "Retries return the original result.", "u4")`;
+const FLASH = `root = Flashcard("Idempotency keys", "Retries with the same key return the original result.", "u4")`;
+
+describe("every Phase 3 card parses cleanly", () => {
+  it.each([
+    ["DecisionCard", DECISION],
+    ["Timeline", TIMELINE],
+    ["FlowDiagram", FLOW],
+    ["QuizCard", QUIZ],
+    ["Flashcard", FLASH],
+    ["NoteLink", `root = NoteLink("n2", "See also")`],
+  ])("%s", (name, lang) => {
+    const r = parse(lang);
+    expect(r.meta.errors).toEqual([]);
+    expect(r.meta.incomplete).toBe(false);
+    expect(r.root?.typeName).toBe(name);
+  });
+});
+
+describe("DecisionCard", () => {
+  it("highlights the decision and lets the reader select options to compare", () => {
+    renderLang(DECISION);
+    const options = $$(".openui-decision__option");
+    expect(options).toHaveLength(2);
+    expect(options[1]!.dataset.chosen).toBe("true");
+    expect(options[0]!.dataset.chosen).toBeUndefined();
+    expect(host.textContent).toContain("Orders need strict per-customer ordering.");
+    expect(host.textContent).toContain("Best-effort ordering");
+
+    click(options[0]);
+    expect(options[0]!.getAttribute("aria-pressed")).toBe("true");
+    click(options[1]);
+    expect(options[0]!.getAttribute("aria-pressed")).toBe("false");
+    expect(options[1]!.getAttribute("aria-pressed")).toBe("true");
+    click(options[1]);
+    expect(options[1]!.getAttribute("aria-pressed")).toBe("false");
+  });
+
+  it("expands a cited passage only when the host can supply it", () => {
+    renderLang(DECISION);
+    expect($('span.openui-citation-chip[data-unit="u3"]')).toBeTruthy();
+    renderLang(DECISION, { unitText: (u) => (u === "u3" ? "FIFO queues keep order within a message group." : undefined) });
+    click($('button.openui-citation-chip[data-unit="u3"]'));
+    expect($(".openui-idea-card__passage")?.textContent).toBe("FIFO queues keep order within a message group.");
+  });
+});
+
+describe("Timeline", () => {
+  it("toggles an event's detail and passage; an event without either can't expand", () => {
+    renderLang(TIMELINE, { unitText: () => "Canary served 5% of traffic for 24 hours." });
+    const heads = $$(".openui-timeline__head");
+    expect(heads).toHaveLength(2);
+    // e2 has no detail and no unit.
+    expect((heads[1] as HTMLButtonElement).disabled).toBe(true);
+    expect($(".openui-timeline__detail")).toBeNull();
+
+    click(heads[0]);
+    expect($(".openui-timeline__detail")?.textContent).toContain("Error rate held at baseline.");
+    expect($(".openui-timeline__detail")?.textContent).toContain("Canary served 5% of traffic");
+    click(heads[0]);
+    expect($(".openui-timeline__detail")).toBeNull();
+  });
+});
+
+describe("FlowDiagram", () => {
+  it("renders connected steps and shows the selected step's detail", () => {
+    renderLang(FLOW);
+    const nodes = $$(".openui-flow__node");
+    expect(nodes).toHaveLength(3);
+    expect($$(".openui-flow__arrow")).toHaveLength(2);
+    expect($(".openui-flow__detail")).toBeNull();
+    click(nodes[2]);
+    expect(nodes[2]!.getAttribute("aria-pressed")).toBe("true");
+    expect($(".openui-flow__detail")?.textContent).toContain("Load balancer flips.");
+    click(nodes[2]);
+    expect($(".openui-flow__detail")).toBeNull();
+  });
+});
+
+describe("QuizCard", () => {
+  it("marks a wrong pick, shows the answer and explanation, and resets on Try again", () => {
+    renderLang(QUIZ);
+    const choices = $$(".openui-quiz__choice");
+    click(choices[0]);
+    expect($(".openui-quiz")?.dataset.state).toBe("incorrect");
+    expect($(".openui-quiz__verdict")?.textContent).toContain("Duplicate charges");
+    expect($(".openui-quiz__explanation")?.textContent).toBe("Retries return the original result.");
+    expect(choices[1]!.dataset.result).toBe("answer");
+    expect(choices[0]!.dataset.result).toBe("wrong");
+
+    click($(".openui-quiz__retry"));
+    expect($(".openui-quiz")?.dataset.state).toBe("open");
+    click($$(".openui-quiz__choice")[1]);
+    expect($(".openui-quiz")?.dataset.state).toBe("correct");
+  });
+
+  it("binds `selected` to a $variable: the pick lands in the Renderer's store (what a host persists) — no model round-trip", () => {
+    // The store is observed through onStateUpdate (what a host would persist via `initialState`).
+    const bound = `
+$pick = null
+root = QuizCard("What does an idempotency key prevent?", ["Slow responses", "Duplicate charges"], 1, "Retries return the original result.", null, $pick)
+`.trim();
+    const parsed = parse(bound);
+    expect(parsed.meta.errors).toEqual([]);
+
+    const updates: Record<string, unknown>[] = [];
+    const fetchSpy = vi.spyOn(globalThis, "fetch");
+    renderLang(bound, {}, (s) => updates.push({ ...s }));
+    click($$(".openui-quiz__choice")[1]);
+    expect($(".openui-quiz")?.dataset.state).toBe("correct");
+    expect(updates.at(-1)).toMatchObject({ $pick: 1 });
+
+    click($(".openui-quiz__retry"));
+    expect($(".openui-quiz")?.dataset.state).toBe("open");
+    expect(updates.at(-1)?.$pick ?? null).toBeNull();
+    expect(fetchSpy).not.toHaveBeenCalled();
+    fetchSpy.mockRestore();
+  });
+});
+
+describe("Flashcard", () => {
+  it("flips between prompt and answer", () => {
+    renderLang(FLASH);
+    const face = $(".openui-flashcard__face");
+    expect(face?.textContent).toContain("Idempotency keys");
+    click(face);
+    expect($(".openui-flashcard__face")?.textContent).toContain("Retries with the same key");
+    expect($('[data-unit="u4"]')).toBeTruthy();
+    click($(".openui-flashcard__face"));
+    expect($(".openui-flashcard__face")?.textContent).toContain("Prompt");
+  });
+});
+
+describe("NoteLink", () => {
+  it("navigates through the host, labelled with the target note's title", () => {
+    const navigate = vi.fn();
+    renderLang(`root = NoteLink("n2")`, { navigate, noteTitle: (id) => (id === "n2" ? "Keys expire" : undefined) });
+    const link = $("button.openui-note-link");
+    expect(link?.textContent).toContain("Keys expire");
+    click(link);
+    expect(navigate).toHaveBeenCalledWith("n2");
+  });
+
+  it("is plain text with no host, falling back to the label then the id", () => {
+    renderLang(`root = NoteLink("n2", "See also")`);
+    expect($("button.openui-note-link")).toBeNull();
+    expect($("span.openui-note-link")?.textContent).toBe("See also");
+    renderLang(`root = NoteLink("n9")`);
+    expect($("span.openui-note-link")?.textContent).toBe("n9");
+  });
+});
diff --git a/src/ai/openui/interactions.tsx b/src/ai/openui/interactions.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..42e7e09828af01204612b54c258cafd1a2087fe9
--- /dev/null
+++ b/src/ai/openui/interactions.tsx
@@ -0,0 +1,384 @@
+"use client";
+
+/**
+ * Phase 3 knowledge-interaction components (`.ai/docs/openui-integration-plan.md` §1 Phase 3): decision, timeline,
+ * flow-diagram, quiz, flashcard and cross-note-link cards. Every interaction is component-local React state, a bound
+ * OpenUI `$variable` (QuizCard's `selected`), or a capability the host offers through `useNotesHost()` — never a model
+ * call (Phase 3 acceptance: "meaningful interaction without additional model calls for basic UI actions"). With no host,
+ * each renders statically and stays usable.
+ *
+ * Props are positional (the order of each Zod object's keys), so new props are only ever appended. `library.tsx`
+ * registers `interactionComponents`; styles live in `components/openui/interactions.css`.
+ *
+ * This module cannot import `library.tsx` (it imports us), so citations here are plain unit ids rendered as chips.
+ */
+import { defineComponent, reactive, useStateField, type DefinedComponent, type ElementNode } from "@openuidev/react-lang";
+import { useId, useState } from "react";
+import { z } from "zod/v4";
+import { useNotesHost } from "./hostContext";
+
+/** A child node's props as the parser left them (possibly partial while streaming). */
+function propsOf(node: unknown): Record<string, unknown> {
+  const p = (node as ElementNode | null | undefined)?.props;
+  return p && typeof p === "object" ? (p as Record<string, unknown>) : {};
+}
+const str = (v: unknown): string | undefined => (typeof v === "string" ? v : undefined);
+const strs = (v: unknown): string[] => (Array.isArray(v) ? v.filter((x): x is string => typeof x === "string") : []);
+
+/** Unit chips that expand to the cited passage when the host can supply it. */
+function UnitChips({ units }: { units: readonly string[] }) {
+  const host = useNotesHost();
+  const [open, setOpen] = useState<string | null>(null);
+  if (!units.length) return null;
+  const passage = open ? host.unitText?.(open) : undefined;
+  return (
+    <>
+      <div className="openui-idea-card__citations">
+        {units.map((u) =>
+          host.unitText?.(u) ? (
+            <button key={u} type="button" className="openui-citation-chip" data-unit={u} aria-expanded={open === u} onClick={() => setOpen((c) => (c === u ? null : u))}>
+              {u}
+            </button>
+          ) : (
+            <span key={u} className="openui-citation-chip" data-unit={u}>
+              {u}
+            </span>
+          ),
+        )}
+      </div>
+      {passage && <blockquote className="openui-idea-card__passage">{passage}</blockquote>}
+    </>
+  );
+}
+
+// ── DecisionCard ────────────────────────────────────────────────────────────
+
+const DecisionOption = defineComponent({
+  name: "DecisionOption",
+  description: "One option a DecisionCard weighs: its name and short pros/cons. Only used inside DecisionCard.options.",
+  props: z.object({
+    name: z.string(),
+    pros: z.array(z.string()).optional(),
+    cons: z.array(z.string()).optional(),
+  }),
+  component: ({ props }) => <OptionBody name={props.name} pros={props.pros ?? []} cons={props.cons ?? []} />,
+});
+
+function OptionBody({ name, pros, cons }: { name: string; pros: string[]; cons: string[] }) {
+  return (
+    <div className="openui-decision__option-body">
+      <span className="openui-decision__option-name">{name}</span>
+      {pros.length > 0 && (
+        <ul className="openui-decision__pros" aria-label="Pros">
+          {pros.map((p, i) => (
+            <li key={i}>{p}</li>
+          ))}
+        </ul>
+      )}
+      {cons.length > 0 && (
+        <ul className="openui-decision__cons" aria-label="Cons">
+          {cons.map((c, i) => (
+            <li key={i}>{c}</li>
+          ))}
+        </ul>
+      )}
+    </div>
+  );
+}
+
+function DecisionCardView({ question, options, chosen, rationale, citations }: { question: string; options: unknown[]; chosen?: string; rationale?: string; citations: string[] }) {
+  const [selected, setSelected] = useState<string | null>(null);
+  return (
+    <article className="openui-decision" data-note-id={useNotesHost().noteId}>
+      <h3 className="openui-decision__question">{question}</h3>
+      <div className="openui-decision__options" role="group" aria-label="Options">
+        {options.map((node, i) => {
+          const p = propsOf(node);
+          const name = str(p.name) ?? "";
+          return (
+            <button
+              key={`${i}-${name}`}
+              type="button"
+              className="openui-decision__option"
+              aria-pressed={selected === name}
+              data-chosen={chosen === name || undefined}
+              onClick={() => setSelected((s) => (s === name ? null : name))}
+            >
+              {chosen === name && <span className="openui-decision__badge">Decision</span>}
+              <OptionBody name={name} pros={strs(p.pros)} cons={strs(p.cons)} />
+            </button>
+          );
+        })}
+      </div>
+      {rationale && (
+        <p className="openui-decision__rationale">
+          <strong>Why:</strong> {rationale}
+        </p>
+      )}
+      <UnitChips units={citations} />
+    </article>
+  );
+}
+
+const DecisionCard = defineComponent({
+  name: "DecisionCard",
+  description:
+    "A decision and the options weighed for it. `options` are DecisionOption children; `chosen` is the exact name of the option decided on (omit if undecided); `rationale` says why; `citations` are source unit ids.",
+  props: z.object({
+    question: z.string(),
+    options: z.array(DecisionOption.ref),
+    chosen: z.string().optional(),
+    rationale: z.string().optional(),
+    citations: z.array(z.string()).optional().describe("Source unit ids, e.g. [\"u4\"]."),
+  }),
+  component: ({ props }) => (
+    <DecisionCardView question={props.question} options={(props.options ?? []) as unknown[]} chosen={props.chosen} rationale={props.rationale} citations={props.citations ?? []} />
+  ),
+});
+
+// ── Timeline ────────────────────────────────────────────────────────────────
+
+const TimelineEvent = defineComponent({
+  name: "TimelineEvent",
+  description: "One dated event in a Timeline: when, a short label, optional detail, optional source unit id. Only used inside Timeline.events.",
+  props: z.object({
+    when: z.string(),
+    label: z.string(),
+    detail: z.string().optional(),
+    unit: z.string().optional(),
+  }),
+  component: ({ props }) => (
+    <span className="openui-timeline__static">
+      <span className="openui-timeline__when">{props.when}</span> {props.label}
+    </span>
+  ),
+});
+
+function TimelineView({ title, events }: { title: string; events: unknown[] }) {
+  const host = useNotesHost();
+  const [open, setOpen] = useState<number | null>(null);
+  const baseId = useId();
+  return (
+    <article className="openui-timeline">
+      <h3 className="openui-timeline__title">{title}</h3>
+      <ol className="openui-timeline__list">
+        {events.map((node, i) => {
+          const p = propsOf(node);
+          const detail = str(p.detail);
+          const unit = str(p.unit);
+          const passage = unit ? host.unitText?.(unit) : undefined;
+          const expandable = !!(detail || passage);
+          const isOpen = open === i;
+          return (
+            <li key={i} className="openui-timeline__event" data-open={isOpen || undefined}>
+              <button
+                type="button"
+                className="openui-timeline__head"
+                aria-expanded={expandable ? isOpen : undefined}
+                aria-controls={expandable ? `${baseId}-${i}` : undefined}
+                disabled={!expandable}
+                onClick={() => setOpen((o) => (o === i ? null : i))}
+              >
+                <span className="openui-timeline__when">{str(p.when) ?? ""}</span>
+                <span className="openui-timeline__label">{str(p.label) ?? ""}</span>
+              </button>
+              {isOpen && (
+                <div className="openui-timeline__detail" id={`${baseId}-${i}`}>
+                  {detail && <p>{detail}</p>}
+                  {passage && (
+                    <blockquote className="openui-idea-card__passage" data-unit={unit}>
+                      {passage}
+                    </blockquote>
+                  )}
+                </div>
+              )}
+            </li>
+          );
+        })}
+      </ol>
+    </article>
+  );
+}
+
+const Timeline = defineComponent({
+  name: "Timeline",
+  description: "Events in time order (TimelineEvent children). Use for history, rollouts, incident sequences — not for unordered facts.",
+  props: z.object({
+    title: z.string(),
+    events: z.array(TimelineEvent.ref),
+  }),
+  component: ({ props }) => <TimelineView title={props.title} events={(props.events ?? []) as unknown[]} />,
+});
+
+// ── FlowDiagram ─────────────────────────────────────────────────────────────
+
+function FlowDiagramView({ title, steps, details }: { title: string; steps: string[]; details: string[] }) {
+  const [active, setActive] = useState<number | null>(null);
+  const detailId = useId();
+  const detail = active !== null ? details[active] : undefined;
+  return (
+    <article className="openui-flow">
+      <h3 className="openui-flow__title">{title}</h3>
+      <ol className="openui-flow__steps">
+        {steps.map((s, i) => (
+          <li key={i} className="openui-flow__step">
+            <button
+              type="button"
+              className="openui-flow__node"
+              aria-pressed={active === i}
+              aria-controls={details[i] ? detailId : undefined}
+              disabled={!details[i]}
+              onClick={() => setActive((a) => (a === i ? null : i))}
+            >
+              <span className="openui-flow__index">{i + 1}</span> {s}
+            </button>
+            {i < steps.length - 1 && (
+              <span className="openui-flow__arrow" aria-hidden="true">
+                →
+              </span>
+            )}
+          </li>
+        ))}
+      </ol>
+      {detail && (
+        <p className="openui-flow__detail" id={detailId} aria-live="polite">
+          <strong>
+            {active! + 1}. {steps[active!]}:
+          </strong>{" "}
+          {detail}
+        </p>
+      )}
+    </article>
+  );
+}
+
+const FlowDiagram = defineComponent({
+  name: "FlowDiagram",
+  description: "A short process as connected steps, left to right. `details[i]` explains step i and shows when the reader selects it. Keep to 2–7 steps.",
+  props: z.object({
+    title: z.string(),
+    steps: z.array(z.string()).min(1),
+    details: z.array(z.string()).optional(),
+  }),
+  component: ({ props }) => <FlowDiagramView title={props.title} steps={props.steps ?? []} details={props.details ?? []} />,
+});
+
+// ── QuizCard ────────────────────────────────────────────────────────────────
+
+function QuizCardView({ question, choices, answer, explanation, unit, binding }: { question: string; choices: string[]; answer: number; explanation?: string; unit?: string; binding: unknown }) {
+  const host = useNotesHost();
+  // Bound to a `$variable` when the Lang passes one (then the pick lives in the Renderer's store and other bound
+  // components see it); otherwise plain local state.
+  const field = useStateField<number | null>("selected", binding as number | null | undefined);
+  const [local, setLocal] = useState<number | null>(null);
+  const picked = field.isReactive ? (typeof field.value === "number" ? field.value : null) : local;
+  const pick = (i: number | null) => (field.isReactive ? field.setValue(i) : setLocal(i));
+  const answered = picked !== null;
+  const correct = answered && picked === answer;
+  const passage = unit ? host.unitText?.(unit) : undefined;
+  return (
+    <article className="openui-quiz" data-state={!answered ? "open" : correct ? "correct" : "incorrect"}>
+      <h3 className="openui-quiz__question">{question}</h3>
+      <div className="openui-quiz__choices" role="group" aria-label="Choices">
+        {choices.map((c, i) => (
+          <button
+            key={i}
+            type="button"
+            className="openui-quiz__choice"
+            aria-pressed={picked === i}
+            data-result={answered && i === answer ? "answer" : answered && i === picked ? "wrong" : undefined}
+            disabled={answered}
+            onClick={() => pick(i)}
+          >
+            {c}
+          </button>
+        ))}
+      </div>
+      {answered && (
+        <div className="openui-quiz__feedback" role="status">
+          <p className="openui-quiz__verdict">{correct ? "Correct." : `Not quite — the answer is “${choices[answer] ?? ""}”.`}</p>
+          {explanation && <p className="openui-quiz__explanation">{explanation}</p>}
+          {passage && <blockquote className="openui-idea-card__passage">{passage}</blockquote>}
+          <button type="button" className="openui-quiz__retry" onClick={() => pick(null)}>
+            Try again
+          </button>
+        </div>
+      )}
+    </article>
+  );
+}
+
+const QuizCard = defineComponent({
+  name: "QuizCard",
+  description:
+    "A multiple-choice check on one idea. `answer` is the 0-based index of the correct choice; `explanation` is shown after answering; `unit` is the source unit it tests. `selected` may be bound to a $variable to share the pick.",
+  props: z.object({
+    question: z.string(),
+    choices: z.array(z.string()).min(2),
+    answer: z.number().int().min(0),
+    explanation: z.string().optional(),
+    unit: z.string().optional(),
+    selected: reactive(z.number().int().nullable().optional()),
+  }),
+  component: ({ props }) => (
+    <QuizCardView question={props.question} choices={props.choices ?? []} answer={props.answer} explanation={props.explanation} unit={props.unit} binding={props.selected} />
+  ),
+});
+
+// ── Flashcard ───────────────────────────────────────────────────────────────
+
+function FlashcardView({ front, back, unit }: { front: string; back: string; unit?: string }) {
+  const [flipped, setFlipped] = useState(false);
+  return (
+    <article className="openui-flashcard" data-flipped={flipped || undefined}>
+      <button type="button" className="openui-flashcard__face" aria-pressed={flipped} aria-label={flipped ? "Show front" : "Show answer"} onClick={() => setFlipped((f) => !f)}>
+        <span className="openui-flashcard__side">{flipped ? "Answer" : "Prompt"}</span>
+        <span className="openui-flashcard__text">{flipped ? back : front}</span>
+      </button>
+      {flipped && unit && <UnitChips units={[unit]} />}
+    </article>
+  );
+}
+
+const Flashcard = defineComponent({
+  name: "Flashcard",
+  description: "A study card: `front` is a prompt (usually the idea's title), `back` the idea itself; the reader flips it. `unit` is the source unit.",
+  props: z.object({
+    front: z.string(),
+    back: z.string(),
+    unit: z.string().optional(),
+  }),
+  component: ({ props }) => <FlashcardView front={props.front} back={props.back} unit={props.unit} />,
+});
+
+// ── NoteLink ────────────────────────────────────────────────────────────────
+
+function NoteLinkView({ target, label }: { target: string; label?: string }) {
+  const host = useNotesHost();
+  const text = label ?? host.noteTitle?.(target) ?? target;
+  if (!host.navigate) {
+    return (
+      <span className="openui-note-link" data-target={target}>
+        {text}
+      </span>
+    );
+  }
+  return (
+    <button type="button" className="openui-note-link" data-target={target} onClick={() => host.navigate!(target)}>
+      <span aria-hidden="true">→</span> {text}
+    </button>
+  );
+}
+
+export const NoteLink = defineComponent({
+  name: "NoteLink",
+  description: "A link to another note in the same notes view, by its note id. Use for 'see also' between related ideas; never invent an id.",
+  props: z.object({
+    target: z.string().describe("The other note's id."),
+    label: z.string().optional(),
+  }),
+  component: ({ props }) => <NoteLinkView target={props.target} label={props.label} />,
+});
+
+// eslint-disable-next-line @typescript-eslint/no-explicit-any
+export const interactionComponents: DefinedComponent<any>[] = [DecisionOption, DecisionCard, TimelineEvent, Timeline, FlowDiagram, QuizCard, Flashcard, NoteLink];
diff --git a/src/ai/openui/library.test.tsx b/src/ai/openui/library.test.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..2d74011c25e34a394d5b83a0de26ebd0f145f07a
--- /dev/null
+++ b/src/ai/openui/library.test.tsx
@@ -0,0 +1,92 @@
+/**
+ * Phase 1 acceptance (`.ai/docs/open-intelligent-ui-audit.md`, Option A): "validate streaming and deterministic
+ * rendering." No model calls here — a static OpenUI Lang fixture, parsed and rendered through the real
+ * `@openuidev/react-lang` runtime against `acuteCardLibrary`.
+ */
+import { createParser, createStreamingParser, type ElementNode } from "@openuidev/react-lang";
+import { renderToStaticMarkup } from "react-dom/server";
+import { describe, expect, it } from "vitest";
+import { acuteCardLibrary } from "./library";
+import { OpenUiCardRenderer } from "@/components/openui/OpenUiCardRenderer";
+
+const FIXTURE = `
+root = IdeaCard("Idempotency keys prevent duplicate charges", "When a client retries a payment request after a timeout, the server matches the request's idempotency key and returns the original result instead of charging twice.", "high", [c1, c2])
+c1 = CitationChip("u4")
+c2 = CitationChip("u7", "u7")
+`.trim();
+
+const schema = acuteCardLibrary.toJSONSchema();
+
+function asIdeaCard(root: ElementNode | null) {
+  if (!root || root.typeName !== "IdeaCard") throw new Error(`expected an IdeaCard root, got ${root?.typeName}`);
+  return root;
+}
+
+describe("acuteCardLibrary — deterministic parsing", () => {
+  it("parses the same fixture identically across independent parser instances", () => {
+    const first = createParser(schema).parse(FIXTURE);
+    const second = createParser(schema).parse(FIXTURE);
+
+    for (const result of [first, second]) {
+      expect(result.meta.incomplete).toBe(false);
+      expect(result.meta.errors).toEqual([]);
+      expect(result.meta.unresolved).toEqual([]);
+      expect(result.meta.statementCount).toBe(3);
+    }
+
+    const a = asIdeaCard(first.root);
+    const b = asIdeaCard(second.root);
+    expect(a.props).toEqual(b.props);
+  });
+
+  it("maps positional args to named props in the library's Zod key order", () => {
+    const { root } = createParser(schema).parse(FIXTURE);
+    const card = asIdeaCard(root);
+
+    expect(card.props.title).toBe("Idempotency keys prevent duplicate charges");
+    expect(card.props.importance).toBe("high");
+
+    const citations = card.props.citations as ElementNode[];
+    expect(citations).toHaveLength(2);
+    expect(citations[0]!.typeName).toBe("CitationChip");
+    expect(citations[0]!.props.unit).toBe("u4");
+    expect(citations[1]!.props.label).toBe("u7");
+  });
+});
+
+describe("acuteCardLibrary — streaming parser", () => {
+  it("converges to the same result as a one-shot parse as chunks arrive", () => {
+    const streaming = createStreamingParser(schema);
+    const chunkSize = 24;
+    let sawIncomplete = false;
+
+    for (let i = chunkSize; i < FIXTURE.length; i += chunkSize) {
+      const partial = streaming.set(FIXTURE.slice(0, i));
+      if (partial.meta.incomplete) sawIncomplete = true;
+    }
+    const final = streaming.set(FIXTURE, true);
+
+    // The point of streaming: it actually was incomplete at some point, not just complete from chunk one.
+    expect(sawIncomplete).toBe(true);
+    expect(final.meta.incomplete).toBe(false);
+    expect(final.meta.statementCount).toBe(3);
+
+    const oneShot = createParser(schema).parse(FIXTURE);
+    expect(asIdeaCard(final.root).props).toEqual(asIdeaCard(oneShot.root).props);
+  });
+});
+
+describe("OpenUiCardRenderer — renders the parsed tree", () => {
+  it("renders the card's title, body and citation chips to markup", () => {
+    const html = renderToStaticMarkup(<OpenUiCardRenderer response={FIXTURE} isStreaming={false} />);
+
+    expect(html).toContain("Idempotency keys prevent duplicate charges");
+    expect(html).toContain("openui-idea-card");
+    expect(html).toContain('data-unit="u4"');
+    expect(html).toContain('data-unit="u7"');
+  });
+
+  it("renders nothing unsafe when response is null (nothing streamed in yet)", () => {
+    expect(() => renderToStaticMarkup(<OpenUiCardRenderer response={null} isStreaming />)).not.toThrow();
+  });
+});
diff --git a/src/ai/openui/library.tsx b/src/ai/openui/library.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..d21c496ab65d9d5f9db076045302654f74848f54
--- /dev/null
+++ b/src/ai/openui/library.tsx
@@ -0,0 +1,248 @@
+"use client";
+
+/**
+ * The OpenUI component library for Acute's note cards (`.ai/docs/open-intelligent-ui-audit.md` Option A, extended by
+ * `.ai/docs/openui-integration-plan.md` Phases 2–3): primitives a model — or the deterministic Notes view builder
+ * (`notesModel.ts`) — arranges into one distilled idea card, mirroring the vocabulary Visualize already uses
+ * (`VisualNode`, knowledge-notes `sourceUnits`/`CardReview`) without reading or writing any of that code.
+ *
+ * Interactive behaviour (expanding a citation's passage, "More", Pin) is component-local React state plus what the
+ * host offers through `useNotesHost()` — never a model call. Outside a host every component renders statically.
+ *
+ * Example OpenUI Lang this library accepts (positional args, in each component's Zod key order):
+ *
+ * ```
+ * root = IdeaCard("Idempotency keys prevent duplicate charges", "When a client retries a payment request after a
+ * timeout, the server matches the request's idempotency key and returns the original result instead of charging
+ * twice.", "high", [c1, c2])
+ * c1 = CitationChip("u4")
+ * c2 = CitationChip("u7", "u7")
+ * ```
+ *
+ * Props are positional, so a new prop is only ever appended (`detail`, `extras` came after Phase 1's four); reordering
+ * would silently change what stored or generated Lang means.
+ */
+import { createLibrary, defineComponent, type PromptOptions } from "@openuidev/react-lang";
+import { createContext, useContext, useId, useState, type ReactNode } from "react";
+import { z } from "zod/v4";
+import { useNotesHost } from "./hostContext";
+import { interactionComponents, NoteLink } from "./interactions";
+
+/** Which citation of the enclosing IdeaCard has its passage open (one at a time, shown under the chips). */
+interface OpenCitation {
+  open: string | null;
+  toggle(unit: string): void;
+}
+const OpenCitationContext = createContext<OpenCitation | null>(null);
+
+function CitationChipView({ unit, label }: { unit: string; label?: string }) {
+  const host = useNotesHost();
+  const card = useContext(OpenCitationContext);
+  const text = host.unitText?.(unit);
+  // Static chip when there's nothing to expand (no host, unknown unit, or outside an IdeaCard).
+  if (!text || !card) {
+    return (
+      <span className="openui-citation-chip" data-unit={unit} title={`Source unit ${unit}`}>
+        {label ?? unit}
+      </span>
+    );
+  }
+  const open = card.open === unit;
+  return (
+    <button
+      type="button"
+      className="openui-citation-chip"
+      data-unit={unit}
+      data-open={open || undefined}
+      aria-expanded={open}
+      title={open ? "Hide source passage" : "Show source passage"}
+      onClick={() => card.toggle(unit)}
+    >
+      {label ?? unit}
+    </button>
+  );
+}
+
+const CitationChip = defineComponent({
+  name: "CitationChip",
+  description:
+    "An inline marker citing one source unit this card represents. Use one per unit cited, never one chip for several units.",
+  props: z.object({
+    unit: z.string().describe('The source unit id, e.g. "u17". Never a heading or a made-up id.'),
+    label: z.string().optional().describe("Short label on the chip; defaults to the unit id."),
+  }),
+  component: ({ props }) => <CitationChipView unit={props.unit} label={props.label} />,
+});
+
+function SourceLinkView({ unit, label }: { unit: string; label?: string }) {
+  const host = useNotesHost();
+  return (
+    <button type="button" className="openui-source-link" data-unit={unit} onClick={host.openSource ? () => host.openSource!([unit]) : undefined}>
+      <span aria-hidden="true">↗</span> {label ?? "View source"}
+    </button>
+  );
+}
+
+const SourceLink = defineComponent({
+  name: "SourceLink",
+  description: "A prominent 'view in source' affordance for one unit, distinct from an inline CitationChip.",
+  props: z.object({
+    unit: z.string().describe("The source unit id this points at."),
+    label: z.string().optional().describe('Link text; defaults to "View source".'),
+  }),
+  component: ({ props }) => <SourceLinkView unit={props.unit} label={props.label} />,
+});
+
+const Callout = defineComponent({
+  name: "Callout",
+  description:
+    "A short aside flagging something about the idea itself (a caveat, an open question, why it needs review) — not a citation and not the idea's main body.",
+  props: z.object({
+    tone: z.enum(["info", "warning", "success"]).describe("info: context. warning: caveat/needs review. success: confirmed/resolved."),
+    text: z.string(),
+  }),
+  component: ({ props }) => (
+    <p className="openui-callout" data-tone={props.tone}>
+      {props.text}
+    </p>
+  ),
+});
+
+const ComparisonTable = defineComponent({
+  name: "ComparisonTable",
+  description: "A small table for comparing a few options or facts side by side. Keep it to a handful of rows; prose fits better in the card body otherwise.",
+  props: z.object({
+    columns: z.array(z.string()).min(1),
+    rows: z.array(z.array(z.string())),
+  }),
+  component: ({ props }) => (
+    <table className="openui-comparison-table">
+      <thead>
+        <tr>
+          {props.columns.map((col, i) => (
+            <th key={i}>{col}</th>
+          ))}
+        </tr>
+      </thead>
+      <tbody>
+        {props.rows.map((row, r) => (
+          <tr key={r}>
+            {row.map((cell, c) => (
+              <td key={c}>{cell}</td>
+            ))}
+          </tr>
+        ))}
+      </tbody>
+    </table>
+  ),
+});
+
+interface IdeaCardViewProps {
+  title: string;
+  body: string;
+  importance?: "low" | "medium" | "high";
+  detail?: string;
+  citations: ReactNode;
+  citedUnits: string[];
+  extras: ReactNode;
+}
+
+function IdeaCardView({ title, body, importance, detail, citations, citedUnits, extras }: IdeaCardViewProps) {
+  const host = useNotesHost();
+  const [openUnit, setOpenUnit] = useState<string | null>(null);
+  const [expanded, setExpanded] = useState(false);
+  const detailId = useId();
+  const passage = openUnit ? host.unitText?.(openUnit) : undefined;
+  return (
+    <article className="openui-idea-card" data-importance={importance ?? "medium"} data-note-id={host.noteId}>
+      <h3 className="openui-idea-card__title">{title}</h3>
+      {body && <p className="openui-idea-card__body">{body}</p>}
+      {detail && (
+        <>
+          {expanded && (
+            <p className="openui-idea-card__detail" id={detailId}>
+              {detail}
+            </p>
+          )}
+          <button type="button" className="openui-idea-card__more" aria-expanded={expanded} aria-controls={detailId} onClick={() => setExpanded((e) => !e)}>
+            {expanded ? "Less" : "More"}
+          </button>
+        </>
+      )}
+      {extras && <div className="openui-idea-card__extras">{extras}</div>}
+      {citedUnits.length > 0 && (
+        <OpenCitationContext.Provider value={{ open: openUnit, toggle: (u) => setOpenUnit((cur) => (cur === u ? null : u)) }}>
+          <div className="openui-idea-card__citations">{citations}</div>
+        </OpenCitationContext.Provider>
+      )}
+      {passage && (
+        <blockquote className="openui-idea-card__passage" data-unit={openUnit ?? undefined}>
+          {passage}
+        </blockquote>
+      )}
+      {(host.pin || (host.openSource && citedUnits.length > 0)) && (
+        <div className="openui-idea-card__actions">
+          {host.openSource && citedUnits.length > 0 && (
+            <button type="button" className="openui-idea-card__action" onClick={() => host.openSource!(citedUnits)}>
+              Open in source
+            </button>
+          )}
+          {host.pin && (
+            <button type="button" className="openui-idea-card__action" data-primary disabled={host.pin.done} onClick={() => host.pin!.run()}>
+              {host.pin.label}
+            </button>
+          )}
+        </div>
+      )}
+    </article>
+  );
+}
+
+const IdeaCard = defineComponent({
+  name: "IdeaCard",
+  description:
+    "The root of one distilled idea card: a title, the idea in the model's own words, how important it is, and the source units it represents. Optional `detail` is a longer explanation shown only when the reader asks for more; optional `extras` holds at most a couple of Callout/ComparisonTable/SourceLink/NoteLink children when truly needed — most cards are just title + body + citations.",
+  props: z.object({
+    title: z.string(),
+    body: z.string().describe("The distilled idea, in the model's own words — not a copy of the source sentence. One or two sentences."),
+    importance: z.enum(["low", "medium", "high"]).optional(),
+    citations: z.array(CitationChip.ref).optional().describe("One CitationChip per source unit this card represents."),
+    detail: z.string().optional().describe("Further explanation, hidden behind 'More' until the reader expands it."),
+    extras: z.array(z.union([Callout.ref, ComparisonTable.ref, SourceLink.ref, NoteLink.ref])).optional().describe("Optional asides under the body, including NoteLinks to related cards."),
+  }),
+  component: ({ props, renderNode }) => {
+    const citations = props.citations ?? [];
+    const citedUnits = citations.map((c) => (c as unknown as { props?: { unit?: unknown } }).props?.unit).filter((u): u is string => typeof u === "string");
+    return (
+      <IdeaCardView
+        title={props.title}
+        body={props.body}
+        importance={props.importance}
+        detail={props.detail}
+        citations={citations.length ? renderNode(citations) : null}
+        citedUnits={citedUnits}
+        extras={props.extras && props.extras.length ? renderNode(props.extras) : null}
+      />
+    );
+  },
+});
+
+/** The library: `IdeaCard` is the default root; any component may be a root (a Callout or table on its own, a Phase 3 card). */
+export const acuteCardLibrary = createLibrary({
+  id: "acute-notes-cards-v1",
+  root: "IdeaCard",
+  components: [CitationChip, SourceLink, Callout, ComparisonTable, IdeaCard, ...interactionComponents],
+});
+
+/** Generates the system prompt a model is given to emit this library's OpenUI Lang (`notesTask.ts`). */
+export function acuteCardSystemPrompt(promptOptions?: PromptOptions): string {
+  return acuteCardLibrary.prompt({
+    preamble:
+      "You distil a source document into idea cards. Each IdeaCard holds one idea in your own words, never a copy of the source sentence, and cites the source units (CitationChip) it represents.",
+    additionalRules: [
+      "Never cite a unit id you were not given.",
+      "Prefer one IdeaCard per idea; do not merge unrelated ideas into one card.",
+    ],
+    ...promptOptions,
+  });
+}
diff --git a/src/components/openui/OpenUiCardRenderer.tsx b/src/components/openui/OpenUiCardRenderer.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..4cf5448a99a8f28aaca5f77db4f0158c23a8d1f7
--- /dev/null
+++ b/src/components/openui/OpenUiCardRenderer.tsx
@@ -0,0 +1,22 @@
+"use client";
+
+/**
+ * Phase 1 spike host (`.ai/docs/open-intelligent-ui-audit.md`, Option A): renders one or more `IdeaCard`s from raw
+ * OpenUI Lang. Read-only — there is no editor here. `RichBlockHost` + BlockNote remain the editable path; this
+ * component is never mounted there yet (`OPENUI_CONFIG.enabled` gates whether anything reaches it at all).
+ */
+import type { OpenUIError } from "@openuidev/react-lang";
+import { Renderer } from "@openuidev/react-lang";
+import { acuteCardLibrary } from "@/ai/openui/library";
+
+export interface OpenUiCardRendererProps {
+  /** Raw OpenUI Lang for the card(s), or null while nothing has arrived yet. */
+  response: string | null;
+  /** True while the source is still streaming in; disables form interactions. */
+  isStreaming?: boolean;
+  onError?: (errors: OpenUIError[]) => void;
+}
+
+export function OpenUiCardRenderer({ response, isStreaming, onError }: OpenUiCardRendererProps) {
+  return <Renderer response={response} library={acuteCardLibrary} isStreaming={isStreaming} onError={onError} />;
+}
diff --git a/src/components/openui/interactions.css b/src/components/openui/interactions.css
new file mode 100644
index 0000000000000000000000000000000000000000..7f97a28eaf1b1e8dc92b8727fd7e7fb9c6269836
--- /dev/null
+++ b/src/components/openui/interactions.css
@@ -0,0 +1,302 @@
+/*
+ * Phase 3 knowledge-interaction cards (src/ai/openui/interactions.tsx). Uses the app's --acute-* tokens (globals.css),
+ * which flip under :root[data-theme="dark"]; fallbacks are the light values so the cards also work outside the app.
+ */
+.openui-decision,
+.openui-timeline,
+.openui-flow,
+.openui-quiz,
+.openui-flashcard {
+  border: 1px solid var(--acute-border, #e4e4e8);
+  border-radius: 10px;
+  padding: 16px 18px;
+  background: var(--acute-surface, #ffffff);
+  color: var(--acute-text, #1b1b1f);
+}
+.openui-decision__question,
+.openui-timeline__title,
+.openui-flow__title,
+.openui-quiz__question {
+  margin: 0 0 10px;
+  font-size: 15px;
+}
+
+/* Interactive surfaces share one button reset. */
+.openui-decision__option,
+.openui-timeline__head,
+.openui-flow__node,
+.openui-quiz__choice,
+.openui-quiz__retry,
+.openui-flashcard__face,
+.openui-note-link {
+  font: inherit;
+  color: inherit;
+  cursor: pointer;
+  text-align: left;
+}
+.openui-decision__option:focus-visible,
+.openui-timeline__head:focus-visible,
+.openui-flow__node:focus-visible,
+.openui-quiz__choice:focus-visible,
+.openui-quiz__retry:focus-visible,
+.openui-flashcard__face:focus-visible,
+.openui-note-link:focus-visible {
+  outline: 2px solid var(--acute-accent, #6965db);
+  outline-offset: 2px;
+}
+
+/* DecisionCard */
+.openui-decision__options {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
+  gap: 8px;
+}
+.openui-decision__option {
+  position: relative;
+  border: 1px solid var(--acute-border, #e4e4e8);
+  border-radius: 8px;
+  padding: 10px 12px;
+  background: var(--acute-surface-muted, #f5f5f7);
+}
+.openui-decision__option[aria-pressed="true"] {
+  border-color: var(--acute-accent, #6965db);
+  background: var(--acute-accent-soft, #e0dfff);
+}
+.openui-decision__option[data-chosen] {
+  border-width: 2px;
+  border-color: var(--acute-success, #2b8a3e);
+}
+.openui-decision__badge {
+  display: inline-block;
+  margin-bottom: 4px;
+  font-size: 11px;
+  font-weight: 600;
+  text-transform: uppercase;
+  letter-spacing: 0.04em;
+  color: var(--acute-success, #2b8a3e);
+}
+.openui-decision__option-name {
+  display: block;
+  font-weight: 600;
+  font-size: 14px;
+}
+.openui-decision__pros,
+.openui-decision__cons {
+  margin: 6px 0 0;
+  padding-left: 18px;
+  font-size: 13px;
+}
+.openui-decision__pros li::marker {
+  content: "+ ";
+  color: var(--acute-success, #2b8a3e);
+}
+.openui-decision__cons li::marker {
+  content: "− ";
+  color: var(--acute-danger, #c92a2a);
+}
+.openui-decision__rationale {
+  margin: 10px 0 0;
+  font-size: 13.5px;
+  color: var(--acute-text-muted, #6b6b76);
+}
+
+/* Timeline */
+.openui-timeline__list {
+  list-style: none;
+  margin: 0;
+  padding: 0 0 0 14px;
+  border-left: 2px solid var(--acute-border, #e4e4e8);
+}
+.openui-timeline__event {
+  position: relative;
+  padding: 2px 0 8px 10px;
+}
+.openui-timeline__event::before {
+  content: "";
+  position: absolute;
+  left: -21px;
+  top: 9px;
+  width: 10px;
+  height: 10px;
+  border-radius: 50%;
+  background: var(--acute-surface, #ffffff);
+  border: 2px solid var(--acute-accent, #6965db);
+}
+.openui-timeline__event[data-open]::before {
+  background: var(--acute-accent, #6965db);
+}
+.openui-timeline__head {
+  display: flex;
+  gap: 10px;
+  align-items: baseline;
+  border: 0;
+  background: none;
+  padding: 2px 0;
+}
+.openui-timeline__head:disabled {
+  cursor: default;
+}
+.openui-timeline__when {
+  font-family: ui-monospace, "SF Mono", Consolas, monospace;
+  font-size: 12px;
+  color: var(--acute-text-muted, #6b6b76);
+  min-width: 48px;
+}
+.openui-timeline__label {
+  font-size: 14px;
+}
+.openui-timeline__detail p {
+  margin: 4px 0 0;
+  font-size: 13.5px;
+  color: var(--acute-text-muted, #6b6b76);
+}
+
+/* FlowDiagram */
+.openui-flow__steps {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 6px;
+}
+.openui-flow__step {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+}
+.openui-flow__node {
+  border: 1px solid var(--acute-border, #e4e4e8);
+  border-radius: 8px;
+  padding: 8px 12px;
+  background: var(--acute-surface-muted, #f5f5f7);
+  font-size: 13.5px;
+}
+.openui-flow__node:disabled {
+  cursor: default;
+}
+.openui-flow__node[aria-pressed="true"] {
+  border-color: var(--acute-accent, #6965db);
+  background: var(--acute-accent-soft, #e0dfff);
+}
+.openui-flow__index {
+  display: inline-grid;
+  place-items: center;
+  width: 18px;
+  height: 18px;
+  margin-right: 4px;
+  border-radius: 50%;
+  font-size: 11px;
+  font-weight: 600;
+  background: var(--acute-accent, #6965db);
+  color: var(--acute-cta-text, #ffffff);
+}
+.openui-flow__arrow {
+  color: var(--acute-text-muted, #6b6b76);
+}
+.openui-flow__detail {
+  margin: 12px 0 0;
+  font-size: 13.5px;
+}
+
+/* QuizCard */
+.openui-quiz__choices {
+  display: grid;
+  gap: 6px;
+}
+.openui-quiz__choice {
+  border: 1px solid var(--acute-border, #e4e4e8);
+  border-radius: 8px;
+  padding: 8px 12px;
+  background: var(--acute-surface-muted, #f5f5f7);
+  font-size: 14px;
+}
+.openui-quiz__choice:disabled {
+  cursor: default;
+}
+.openui-quiz__choice[data-result="answer"] {
+  border-color: var(--acute-success, #2b8a3e);
+  box-shadow: inset 3px 0 0 var(--acute-success, #2b8a3e);
+}
+.openui-quiz__choice[data-result="wrong"] {
+  border-color: var(--acute-danger, #c92a2a);
+  box-shadow: inset 3px 0 0 var(--acute-danger, #c92a2a);
+}
+.openui-quiz__feedback {
+  margin-top: 10px;
+  font-size: 13.5px;
+}
+.openui-quiz__verdict {
+  margin: 0 0 4px;
+  font-weight: 600;
+}
+.openui-quiz[data-state="correct"] .openui-quiz__verdict {
+  color: var(--acute-success, #2b8a3e);
+}
+.openui-quiz[data-state="incorrect"] .openui-quiz__verdict {
+  color: var(--acute-danger, #c92a2a);
+}
+.openui-quiz__explanation {
+  margin: 0 0 8px;
+  color: var(--acute-text-muted, #6b6b76);
+}
+.openui-quiz__retry {
+  border: 1px solid var(--acute-border, #e4e4e8);
+  border-radius: 8px;
+  padding: 5px 10px;
+  background: var(--acute-surface, #ffffff);
+  font-size: 13px;
+}
+
+/* Flashcard */
+.openui-flashcard__face {
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+  width: 100%;
+  min-height: 96px;
+  border: 0;
+  background: none;
+  padding: 0;
+}
+.openui-flashcard__side {
+  font-size: 11px;
+  text-transform: uppercase;
+  letter-spacing: 0.04em;
+  color: var(--acute-text-muted, #6b6b76);
+}
+.openui-flashcard__text {
+  font-size: 15px;
+  line-height: 1.5;
+}
+.openui-flashcard[data-flipped] {
+  background: var(--acute-accent-soft, #e0dfff);
+}
+
+/* NoteLink */
+.openui-note-link {
+  display: inline-flex;
+  gap: 4px;
+  border: 0;
+  background: none;
+  padding: 0;
+  color: var(--acute-accent, #6965db);
+  font-size: 13.5px;
+}
+button.openui-note-link:hover {
+  text-decoration: underline;
+}
+span.openui-note-link {
+  cursor: default;
+  color: var(--acute-text-muted, #6b6b76);
+}
+
+@media (prefers-reduced-motion: no-preference) {
+  .openui-decision__option,
+  .openui-flow__node,
+  .openui-quiz__choice,
+  .openui-flashcard {
+    transition: background-color 120ms ease, border-color 120ms ease;
+  }
+}
diff --git a/src/config/openui.ts b/src/config/openui.ts
new file mode 100644
index 0000000000000000000000000000000000000000..66cb4e1a82e7ff5819942c0cada19774fb45232c
--- /dev/null
+++ b/src/config/openui.ts
@@ -0,0 +1,27 @@
+/**
+ * OpenUI generative-UI note cards (`.ai/docs/open-intelligent-ui-audit.md`, `.ai/docs/openui-integration-plan.md`).
+ *
+ * Phase 1 (`OPENUI_CONFIG`): **off by default, and inert when off.** Nothing in `src/ai/visualize/**` or
+ * `src/components/blocks/**` reads it; cards on the canvas keep rendering through `RichBlockHost` + BlockNote.
+ *
+ * Phase 2–3 (`isOpenUiNotesEnabled`): the Notes view — a reading view over the canvas's cards, rendered with the OpenUI
+ * library, with promotion of generated notes into ordinary canvas blocks (`create_block`). A build switch like
+ * `isTopicMergeEnabled`: on in development while it's validated, off unless `NEXT_PUBLIC_OPENUI_NOTES` is exactly "on".
+ * It changes nothing on the canvas itself; the view only reads the canvas, and writes only when the user pins a note.
+ */
+export interface OpenUiConfig {
+  /** Developer setting only, like `FIDELITY_CONFIG.noteModel` was before its own gate. */
+  enabled: boolean;
+  /** Which path renders an AI-authored card's body. `blocknote` is today's behaviour, always available. */
+  noteRender: "blocknote" | "openui";
+}
+
+export const OPENUI_CONFIG: OpenUiConfig = {
+  enabled: false,
+  noteRender: "blocknote",
+};
+
+/** Read on every call so tests can stub the env. The literal `process.env.NEXT_PUBLIC_OPENUI_NOTES` must stay as-is for Next.js to inline it. */
+export function isOpenUiNotesEnabled(): boolean {
+  return process.env.NEXT_PUBLIC_OPENUI_NOTES === "on";
+}
