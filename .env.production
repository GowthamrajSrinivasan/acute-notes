# Loaded by `next build` / `next start`. Build-level switches (see src/config/features.ts).
# NEXT_PUBLIC_* values are baked in at build time: rebuild after changing.
NEXT_PUBLIC_AI_FEATURE=off
# MCP stays off in hosted production until the ChatGPT compatibility spike and security review pass.
MCP_FEATURE=off
NEXT_PUBLIC_MCP_FEATURE=off
MCP_OAUTH_FEATURE=off
